---
/**
 * Renders a data-driven interactive from src/data/interactives.ts.
 * Kinds:
 *   compare – switch between views; each view is a set of bars (optional 95% CI whiskers)
 *   grid    – a field of dots; each view lights a count
 *   curve   – a slider-driven formula (power law / linear) comparing series
 * Every number in the data file must appear in the paper's text (scripts/check-interactives.cjs).
 */
import InteractiveFrame from './InteractiveFrame.astro';
import type { PaperInteractiveData } from '@data/interactives';

interface Props { data: PaperInteractiveData }
const { data } = Astro.props;
const id = `di-${data.doi.replace(/[^a-z0-9]/gi, '')}`;

// Shared scale for compare views so bars are comparable across views
let max = 0;
if (data.kind === 'compare') {
  for (const v of data.views) for (const b of v.bars) max = Math.max(max, b.hi ?? b.value, b.value);
  max = max * 1.08 || 1;
}
const gridTotal = data.kind === 'grid' ? (data.total > 600 ? 100 : data.total) : 0;
const gridScaled = data.kind === 'grid' && data.total > 600;
const cols = data.kind === 'grid' ? (gridTotal <= 100 ? 10 : gridTotal <= 200 ? 20 : 26) : 0;
---

<InteractiveFrame title={data.title} intro={data.intro} source={data.source}>
  <div class="di" id={id} data-di={data.kind} data-payload={JSON.stringify(data)}>
    {data.views && data.views.length > 1 && (
      <div class="pi-seg" role="group" aria-label="Choose a view">
        {data.views.map((v, i) => (
          <button type="button" data-view={i} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>
        ))}
      </div>
    )}

    {data.kind === 'compare' && (
      <div class="di-compare">
        <div class="di-metric">{data.metric}{data.unit ? ` (${data.unit})` : ''}</div>
        {Array.from({ length: Math.max(...data.views.map((v) => v.bars.length)) }, (_, bi) => (
          <div class="di-row" data-row={bi}>
            <span class="di-row-label" data-label></span>
            <span class="di-track">
              <span class="di-ci" data-ci></span>
              <span class="di-bar" data-bar></span>
            </span>
            <span class="di-val" data-val></span>
          </div>
        ))}
      </div>
    )}

    {data.kind === 'grid' && (
      <div class="di-grid-wrap" role="img" aria-label={`A grid of ${gridTotal} dots`} data-grid-img>
        <div class="di-grid" style={`grid-template-columns: repeat(${cols}, minmax(0, 1fr))`} aria-hidden="true">
          {Array.from({ length: gridTotal }, (_, i) => (
            <span class="di-dot" style={`--s:${(i % cols) * 10 + Math.floor(i / cols) * 6}ms`}></span>
          ))}
        </div>
        <div class="di-grid-key">{gridScaled ? `Each dot is 1% of ${data.total.toLocaleString()} ${data.unitLabel}` : `${data.total.toLocaleString()} ${data.unitLabel}, one dot each`}</div>
      </div>
    )}

    {data.kind === 'curve' && (
      <div class="di-curve">
        <svg viewBox="0 0 600 300" class="di-curve-svg" role="img" aria-label={`${data.yLabel} against ${data.xLabel}`}>
          <line x1="60" y1="260" x2="580" y2="260" stroke="rgba(255,255,255,0.25)"></line>
          <line x1="60" y1="20" x2="60" y2="260" stroke="rgba(255,255,255,0.25)"></line>
          <text x="320" y="292" text-anchor="middle" class="di-axis">{data.xLabel}</text>
          <text x="18" y="140" text-anchor="middle" class="di-axis" transform="rotate(-90 18 140)">{data.yLabel}</text>
          {data.series.map((_, i) => (
            <path data-series={i} fill="none" stroke-width={i === 0 ? 3.5 : 2} stroke-dasharray={i === 0 ? '' : '6 6'} class={`di-s di-s${i}`}></path>
          ))}
          <line data-cursor x1="0" x2="0" y1="20" y2="260" stroke="rgba(255,255,255,0.35)" stroke-dasharray="3 4"></line>
          {data.series.map((_, i) => <circle data-dot={i} r="5" class={`di-sd di-sd${i}`}></circle>)}
        </svg>
        <div class="di-legend">
          {data.series.map((s, i) => (
            <span class={`di-leg di-leg${i}`}><i></i>{s.label}</span>
          ))}
        </div>
        <div class="pi-field">
          <div class="pi-field-top"><label for={`${id}-x`}>{data.x.label}</label><output for={`${id}-x`} data-x-out></output></div>
          <input class="pi-range" id={`${id}-x`} type="range" min={data.x.min} max={data.x.max} step={data.x.step} value={data.x.value} data-x>
        </div>
      </div>
    )}

    <div class="pi-verdict" data-note aria-live="polite"></div>
  </div>
</InteractiveFrame>

<style is:global>
  .di { display: grid; gap: 1.1rem; }
  .di-compare { display: grid; gap: 0.7rem; }
  .di-metric { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .di-row { display: grid; grid-template-columns: minmax(7rem, 11rem) 1fr 4.5rem; gap: 0.75rem; align-items: center; }
  .di-row-label { font-size: 0.9rem; color: rgba(255,255,255,0.85); line-height: 1.3; }
  .di-track { position: relative; height: 1.6rem; background: rgba(255,255,255,0.05); border-radius: 0.4rem; overflow: visible; }
  .di-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 0.4rem; background: var(--di-c, #4DA8C9); transition: width 650ms cubic-bezier(.22,1,.36,1), background-color 300ms ease; }
  .di-row[data-tone='b'] { --di-c: #4FB6A5; }
  .di-row[data-tone='c'] { --di-c: #fbbf24; }
  .di-row[data-tone='d'] { --di-c: #fb7185; }
  .di-row[data-tone='e'] { --di-c: rgba(255,255,255,0.35); }
  .di-ci { position: absolute; top: 50%; height: 2px; background: #fff; opacity: 0; z-index: 1; transition: left 650ms cubic-bezier(.22,1,.36,1), width 650ms cubic-bezier(.22,1,.36,1), opacity 300ms; }
  .di-ci::before, .di-ci::after { content: ''; position: absolute; top: -5px; width: 2px; height: 12px; background: #fff; }
  .di-ci::before { left: 0; } .di-ci::after { right: 0; }
  .di-ci.on { opacity: 0.85; }
  .di-val { font-variant-numeric: tabular-nums; font-weight: 700; color: #fff; text-align: right; font-size: 0.95rem; }
  .di-scale { display: flex; justify-content: space-between; margin-left: calc(min(11rem, 30%) + 0.75rem); margin-right: 5.25rem; font-size: 0.7rem; color: rgba(255,255,255,0.4); }
  .di-row-hidden { display: none; }
  @media (max-width: 520px) {
    .di-row { grid-template-columns: 1fr 3.8rem; }
    .di-row-label { grid-column: 1 / -1; }
    .di-scale { display: none; }
  }

  .di-grid-wrap { border-radius: 0.75rem; background: rgba(255,255,255,0.03); padding: 0.9rem; display: grid; gap: 0.6rem; }
  .di-grid { display: grid; gap: 4px; }
  .di-dot { aspect-ratio: 1; border-radius: 50%; background: rgba(255,255,255,0.14); transition: background-color 350ms ease var(--s), transform 350ms ease var(--s); }
  .di-dot.on { background: var(--di-c, #4DA8C9); transform: scale(1.1); }
  .di[data-tone='b'] { --di-c: #4FB6A5; } .di[data-tone='c'] { --di-c: #fbbf24; } .di[data-tone='d'] { --di-c: #fb7185; }
  .di-grid-key { font-size: 0.75rem; color: rgba(255,255,255,0.45); }

  .di-curve { display: grid; gap: 0.8rem; }
  .di-curve-svg { width: 100%; height: auto; display: block; background: rgba(255,255,255,0.03); border-radius: 0.75rem; }
  .di-axis { font: 600 13px Inter, system-ui, sans-serif; fill: rgba(255,255,255,0.55); }
  .di-s0 { stroke: #4DA8C9; } .di-s1 { stroke: #fbbf24; } .di-s2 { stroke: #fb7185; } .di-s3 { stroke: #4FB6A5; }
  .di-sd0 { fill: #4DA8C9; } .di-sd1 { fill: #fbbf24; } .di-sd2 { fill: #fb7185; } .di-sd3 { fill: #4FB6A5; }
  .di-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.85rem; color: rgba(255,255,255,0.8); }
  .di-leg i { display: inline-block; width: 18px; height: 3px; margin-right: 0.45rem; vertical-align: middle; border-radius: 2px; }
  .di-leg0 i { background: #4DA8C9; } .di-leg1 i { background: #fbbf24; } .di-leg2 i { background: #fb7185; } .di-leg3 i { background: #4FB6A5; }

  @media (prefers-reduced-motion: reduce) { .di-bar, .di-ci, .di-dot { transition: none; } }
</style>

<script>
  const fmt = (n: number) => (Math.abs(n) >= 100 ? n.toFixed(0) : Math.abs(n) >= 10 ? n.toFixed(1).replace(/\.0$/, '') : String(+n.toPrecision(3)));

  const evalSeries = (s: any, x: number) => {
    if (s.fn === 'power') return s.a * Math.pow(x, s.b);
    if (s.fn === 'linear') return s.a + s.b * x;
    if (s.fn === 'exp') return s.a * Math.exp(s.b * x);
    return NaN;
  };

  const shuffled = (n: number, seed: number) => {
    const a = Array.from({ length: n }, (_, i) => i);
    let s = seed;
    for (let i = n - 1; i > 0; i--) { s = (s * 9301 + 49297) % 233280; const j = Math.floor((s / 233280) * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
    return a;
  };

  const initOne = (root: HTMLElement) => {
    if (root.dataset.bound) return;
    root.dataset.bound = '1';
    const data = JSON.parse(root.dataset.payload || '{}');
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view]'));

    if (data.kind === 'compare') {
      let max = 0;
      data.views.forEach((v: any) => v.bars.forEach((b: any) => { max = Math.max(max, b.hi ?? b.value, b.value); }));
      max = max * 1.08 || 1;
      const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
      const show = (vi: number) => {
        const v = data.views[vi];
        rows.forEach((row, i) => {
          const b = v.bars[i];
          row.classList.toggle('di-row-hidden', !b);
          if (!b) return;
          row.dataset.tone = b.tone || (i === 0 ? 'e' : 'a');
          row.querySelector<HTMLElement>('[data-label]')!.textContent = b.label;
          row.querySelector<HTMLElement>('[data-val]')!.textContent = b.display ?? fmt(b.value);
          const bar = row.querySelector<HTMLElement>('[data-bar]')!;
          requestAnimationFrame(() => { bar.style.width = `${Math.max(0, (b.value / max) * 100)}%`; });
          const ci = row.querySelector<HTMLElement>('[data-ci]')!;
          if (b.lo !== undefined && b.hi !== undefined) {
            ci.classList.add('on');
            ci.style.left = `${(b.lo / max) * 100}%`;
            ci.style.width = `${((b.hi - b.lo) / max) * 100}%`;
          } else ci.classList.remove('on');
        });
        note.innerHTML = v.note;
      };
      viewBtns.forEach((btn) => btn.addEventListener('click', () => {
        viewBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
        show(+btn.dataset.view!);
      }));
      show(0);
    }

    if (data.kind === 'grid') {
      const dots = Array.from(root.querySelectorAll<HTMLElement>('.di-dot'));
      const order = shuffled(dots.length, 5);
      const img = root.querySelector<HTMLElement>('[data-grid-img]')!;
      const scaled = data.total > 600;
      const show = (vi: number) => {
        const v = data.views[vi];
        const n = scaled ? Math.round((v.count / data.total) * 100) : v.count;
        const on = new Set(order.slice(0, n));
        dots.forEach((d, i) => d.classList.toggle('on', on.has(i)));
        root.dataset.tone = v.tone || ['a', 'b', 'c', 'd'][vi % 4];
        img.setAttribute('aria-label', `${v.count} of ${data.total} ${data.unitLabel} highlighted`);
        note.innerHTML = v.note;
      };
      viewBtns.forEach((btn) => btn.addEventListener('click', () => {
        viewBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
        show(+btn.dataset.view!);
      }));
      show(0);
    }

    if (data.kind === 'curve') {
      const input = root.querySelector<HTMLInputElement>('[data-x]')!;
      const out = root.querySelector<HTMLOutputElement>('[data-x-out]')!;
      const cursor = root.querySelector<SVGLineElement>('[data-cursor]')!;
      const X0 = 60, X1 = 580, Y0 = 260, Y1 = 20;
      const { min, max } = data.x;
      const N = 120;
      let ymax = 0;
      data.series.forEach((s: any) => { for (let i = 0; i <= N; i++) { const y = evalSeries(s, min + (max - min) * i / N); if (isFinite(y)) ymax = Math.max(ymax, y); } });
      ymax = ymax * 1.05 || 1;
      const px = (x: number) => X0 + ((x - min) / (max - min)) * (X1 - X0);
      const py = (y: number) => Y0 - (y / ymax) * (Y0 - Y1);
      data.series.forEach((s: any, si: number) => {
        let d = '';
        for (let i = 0; i <= N; i++) { const x = min + (max - min) * i / N; d += `${i ? 'L' : 'M'}${px(x).toFixed(1)},${py(evalSeries(s, x)).toFixed(1)}`; }
        root.querySelector(`[data-series="${si}"]`)!.setAttribute('d', d);
      });
      const update = () => {
        const x = +input.value;
        out.textContent = `${fmt(x)}${data.x.unit ? ' ' + data.x.unit : ''}`;
        cursor.setAttribute('x1', String(px(x))); cursor.setAttribute('x2', String(px(x)));
        const ys = data.series.map((s: any) => evalSeries(s, x));
        ys.forEach((y: number, i: number) => {
          const c = root.querySelector(`[data-dot="${i}"]`)!;
          c.setAttribute('cx', String(px(x))); c.setAttribute('cy', String(py(y)));
        });
        // note template: {x}, {y0}, {y1}..., {r01} = y0/y1
        note.innerHTML = String(data.note).replace(/\{(x|y\d|r(\d)(\d))\}/g, (_: string, k: string, a?: string, b?: string) => {
          if (k === 'x') return fmt(x);
          if (k[0] === 'y') return fmt(ys[+k.slice(1)]);
          return fmt(ys[+a!] / ys[+b!]);
        });
      };
      input.addEventListener('input', update);
      update();
    }
  };

  const init = () => document.querySelectorAll<HTMLElement>('[data-di]').forEach(initOne);
  document.addEventListener('astro:page-load', init);
</script>
