---
/**
 * Rennick, DiFiore, Curtis, Reed & Stier (2022) Ecology, e3673.
 * "Detrital supply suppresses deforestation to maintain healthy kelp forest ecosystems"
 *
 * From the paper:
 * - Grazing (consumptive capacity) rose linearly with urchin biomass:
 *   purple slope 0.02, red slope 0.0091 (g kelp per g urchin per day). Results, Fig. 2.
 * - Detrital supply = kelp lost as blades and fronds; compared with grazing as (G - D)/(G + D). Methods, Fig. 5.
 * - When grazing > detritus: kelp ~50-fold lower on average (Abstract, Fig. 4b) and kelp declined or
 *   changed little 91% of the time vs 42% when detritus exceeded grazing (Results, Fig. 5).
 * - Reference thresholds: ~668 g/m2 (Ling et al. 2015) and 1246 g/m2 (Dean et al. 1984); kelp often
 *   stayed high above them. Local maximum observed urchin biomass 2038 g/m2 (Methods).
 */
import InteractiveFrame from './InteractiveFrame.astro';
---

<figure class="rennick-film">
  <video controls playsinline preload="none"
    poster="/images/research/rennick-video-poster.jpg"
    width="1080" height="1920"
    aria-label="Pencil animation showing urchins feeding on drift kelp, emerging from crevices when drift stops, and grazing adult kelp">
    <source src="/videos/rennick-drift-kelp.mp4" type="video/mp4" />
    <a href="/videos/rennick-drift-kelp.mp4">Watch the kelp and urchin animation</a>
  </video>
  <figcaption>Conceptual animation: sustained grazing can turn a kelp forest into an urchin barren. The sequence is illustrative, not a measured timeline.</figcaption>
</figure>

<InteractiveFrame
  title="Can the urchins out-eat the drift?"
  intro="When detached kelp reaches the seafloor, urchins can feed on it instead of grazing attached kelp. Compare two drift supplies with the same urchin biomass."
  source="Model and numbers from Rennick, DiFiore, Curtis, Reed & Stier (2022), Ecology: grazing slopes from the mesocosm experiments (Fig. 2); the 50-fold, 91% and 42% figures from 21 years of SBC LTER data (Figs. 4–5). The kelp drawing is illustrative. The drift slider's range is set for display; the paper estimated drift at each site from monthly kelp-loss data."
>
  <div class="kd" data-kd>
    <div class="kd-stage">
      <svg class="kd-svg" viewBox="0 0 600 162" role="img" aria-label="Balance scale comparing drift kelp supply with estimated urchin grazing capacity">
        <!-- balance -->
        <g transform="translate(300 40)">
          <path d="M0,0 L-14,46 H14 Z" fill="#334155"></path>
          <g class="kd-beam">
            <rect x="-170" y="-4" width="340" height="8" rx="4" fill="#94a3b8"></rect>
            <circle r="7" fill="#e2e8f0"></circle>
            <g class="kd-pan kd-pan-l" transform="translate(-160 0)">
              <line x1="0" y1="0" x2="0" y2="34" stroke="#94a3b8" stroke-width="2"></line>
              <path d="M-42,34 H42 L34,48 H-34 Z" fill="#4FB6A5"></path>
              <rect x="-62" y="54" width="124" height="40" rx="6" fill="#0f172a" fill-opacity="0.8"></rect>
              <text y="68" text-anchor="middle" class="kd-pan-label">Drift supply</text>
              <text y="86" text-anchor="middle" class="kd-pan-val" data-kd-dval>20</text>
            </g>
            <g class="kd-pan kd-pan-r" transform="translate(160 0)">
              <line x1="0" y1="0" x2="0" y2="34" stroke="#94a3b8" stroke-width="2"></line>
              <path d="M-42,34 H42 L34,48 H-34 Z" fill="#a78bfa"></path>
              <rect x="-62" y="54" width="124" height="40" rx="6" fill="#0f172a" fill-opacity="0.8"></rect>
              <text y="68" text-anchor="middle" class="kd-pan-label">Urchin grazing</text>
              <text y="86" text-anchor="middle" class="kd-pan-val" data-kd-gval>14</text>
            </g>
          </g>
        </g>
      </svg>
    </div>

    <figure class="kd-reef">
      <div class="kd-art" aria-hidden="true">
        <img class="kd-habitat" src="/images/research/kelp-forest-habitat-pencil.jpg" alt="" width="900" height="600" />
        <img class="kd-barren" src="/images/research/rennick-bare-reef-pencil.jpg" alt="" width="900" height="600" />
        {[48, 23, 74, 36, 61, 12, 87, 55, 29, 80, 43, 68, 18].map((x, i) => (
          <img class="kd-drift" style={`--x:${x}%; --y:${[24, 31, 26][i % 3]}%; --delay:${i * -0.29}s`}
            src="/images/research/drift-kelp-pencil.webp" alt="" width="192" height="63" />
        ))}
        {[13, 28, 45, 61, 78, 91].map((x, i) => (
          <img class="kd-grazer" style={`--x:${x}%; --dx:${[6, -5, 1, -6, 4, -4][i]}cqw; --bottom:${[5, 17, 7, 14, 5, 17][i]}%`}
            src="/images/research/purple-sea-urchin-pencil.jpg" alt="" width="600" height="400" />
        ))}
      </div>
      <figcaption class="kd-scene-caption">Conceptual illustration. The six drawn urchins stay the same; they do not represent a measured density or a forecast.</figcaption>
    </figure>

    <div class="kd-compare" aria-label="Compare drift supply">
      <button type="button" data-kd-preset="more" aria-pressed="false">More drift</button>
      <button type="button" data-kd-preset="less" aria-pressed="false">Less drift</button>
      <button type="button" data-kd-play aria-pressed="false">Play comparison</button>
    </div>

    <div class="pi-controls">
      <div class="pi-field">
        <div class="pi-field-top"><label for="kd-purple">Purple urchin biomass</label><output for="kd-purple" data-kd-out="purple">700 g/m²</output></div>
        <input class="pi-range" id="kd-purple" type="range" min="0" max="2000" step="10" value="700" aria-describedby="kd-th">
        <div class="kd-ticks" aria-hidden="true">
          <span style="left: 33.4%">668</span><span style="left: 62.3%">1246</span>
        </div>
        <span class="pi-hint" id="kd-th">Marks show urchin biomass thresholds from earlier studies (668 g/m², Ling et al. 2015; 1246 g/m², Dean et al. 1984). This study found kelp often stayed healthy above both.</span>
      </div>
      <div class="pi-field">
        <div class="pi-field-top"><label for="kd-red">Red urchin biomass</label><output for="kd-red" data-kd-out="red">0 g/m²</output></div>
        <input class="pi-range" id="kd-red" type="range" min="0" max="2000" step="10" value="0">
        <span class="pi-hint">Red urchins ate less than half as much kelp per gram as purple urchins.</span>
      </div>
      <div class="pi-field">
        <div class="pi-field-top"><label for="kd-drift">Drift kelp supply</label><output for="kd-drift" data-kd-out="drift">20 g/m²/day</output></div>
        <input class="pi-range" id="kd-drift" type="range" min="0" max="65" step="1" value="20">
      </div>
    </div>

    <div class="pi-verdict" data-kd-verdict aria-live="polite"></div>
    <p class="pi-note" data-kd-ratio></p>
  </div>
</InteractiveFrame>

<style>
  .rennick-film { margin: 2rem auto; max-width: 420px; }
  .rennick-film video { display: block; width: 100%; height: auto; background: #fff; }
  .rennick-film figcaption { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.5; }
  .kd { display: grid; gap: 1.25rem; }
  .kd-stage { border-radius: 0.75rem; background: linear-gradient(180deg, #0b2545 0%, #0f172a 100%); overflow: hidden; }
  .kd-svg { width: 100%; height: auto; display: block; }
  .kd-pan-label { font: 600 13px Inter, system-ui, sans-serif; fill: rgba(255,255,255,0.75); }
  .kd-pan-val { font: 800 15px Inter, system-ui, sans-serif; fill: #fff; }
  .kd-beam { transition: transform 600ms cubic-bezier(.34,1.3,.64,1); }
  .kd-pan { transition: transform 600ms cubic-bezier(.34,1.3,.64,1); }
  .kd-reef { margin: 0; }
  .kd-art { position: relative; isolation: isolate; overflow: hidden; container-type: inline-size; background: #fcfbf7; aspect-ratio: 3 / 2; }
  .kd-habitat { display: block; width: 100%; height: auto; }
  .kd-barren { position: absolute; inset: 0; width: 100%; height: auto; opacity: 0; transition: opacity 2.1s ease; }
  .kd[data-state='pressure'] .kd-barren { opacity: 0.35; }
  .kd[data-state='barren'] .kd-barren { opacity: 1; }
  .kd-grazer { position: absolute; left: var(--x); bottom: var(--bottom); width: 12%; height: auto; mix-blend-mode: multiply; transform: translateX(-50%); transition: transform 1.5s ease; }
  .kd:is([data-state='pressure'], [data-state='barren']) .kd-grazer { transform: translate(calc(-50% + var(--dx)), -24%); }
  .kd-drift { position: absolute; left: var(--x); bottom: var(--y); width: 8%; height: auto; opacity: 0; transition: opacity 350ms ease; transform: rotate(-15deg); }
  .kd-drift[data-visible] { opacity: 1; }
  .kd[data-playing] .kd-drift { animation: kd-drift 3.6s linear var(--delay) infinite; }
  @keyframes kd-drift { from { transform: translate(-14cqw, -14cqw) rotate(-28deg); } to { transform: translate(7cqw, 5cqw) rotate(22deg); } }
  .kd-scene-caption { margin-top: 0.5rem; font-size: 0.875rem; }
  .kd-compare { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .kd-compare button { padding: 0.45rem 0.75rem; border: 1px solid #93aaa8; border-radius: 6px; }
  .kd-compare button[aria-pressed='true'] { background: #b5dfd2; color: #142923; }
  .kd-ticks { position: relative; height: 1rem; font-size: 0.7rem; color: rgba(255,255,255,0.5); }
  .kd-ticks span { position: absolute; transform: translateX(-50%); }
  .kd-ticks span::before { content: ''; position: absolute; left: 50%; top: -6px; width: 1px; height: 6px; background: rgba(255,255,255,0.4); }
  @media (prefers-reduced-motion: reduce) {
    .kd-beam, .kd-pan, .kd-barren, .kd-grazer, .kd-drift { transition: none; }
    .kd[data-playing] .kd-drift { animation: none; }
  }
</style>

<script>
  const PURPLE = 0.02;   // g kelp per g urchin per day (Fig. 2)
  const RED = 0.0091;

  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-kd]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const purple = root.querySelector<HTMLInputElement>('#kd-purple')!;
      const red = root.querySelector<HTMLInputElement>('#kd-red')!;
      const drift = root.querySelector<HTMLInputElement>('#kd-drift')!;
      const blades = root.querySelectorAll('.kd-drift');
      const out = (k: string) => root.querySelector<HTMLOutputElement>(`[data-kd-out="${k}"]`)!;
      const beam = root.querySelector<SVGGElement>('.kd-beam')!;
      const panL = root.querySelector<SVGGElement>('.kd-pan-l')!;
      const panR = root.querySelector<SVGGElement>('.kd-pan-r')!;
      const dval = root.querySelector<SVGTextElement>('[data-kd-dval]')!;
      const gval = root.querySelector<SVGTextElement>('[data-kd-gval]')!;
      const verdict = root.querySelector<HTMLElement>('[data-kd-verdict]')!;
      const ratio = root.querySelector<HTMLElement>('[data-kd-ratio]')!;
      const play = root.querySelector<HTMLButtonElement>('[data-kd-play]')!;
      const presets = root.querySelectorAll<HTMLButtonElement>('[data-kd-preset]');
      let timer: number | undefined;

      const capacity = () => PURPLE * +purple.value + RED * +red.value;
      const presetValue = (mode: string) => {
        const grazing = capacity();
        return mode === 'more' ? Math.ceil(grazing + 6) : Math.floor(grazing / 3);
      };

      const stop = () => {
        window.clearTimeout(timer);
        delete root.dataset.playing;
        play.textContent = 'Play comparison';
        play.setAttribute('aria-pressed', 'false');
      };

      const update = () => {
        const p = +purple.value, r = +red.value, D = +drift.value;
        const G = capacity();
        out('purple').textContent = `${p} g/m²`;
        out('red').textContent = `${r} g/m²`;
        out('drift').textContent = `${D} g/m²/day`;
        dval.textContent = `${D.toFixed(1)} g/m²/day`;
        gval.textContent = `${G.toFixed(1)} g/m²/day`;

        const prop = G + D > 0 ? (G - D) / (G + D) : 0;  // the paper's Fig. 5 axis
        const angle = 16 * prop;
        beam.setAttribute('transform', `rotate(${angle.toFixed(2)})`);
        // keep pans hanging vertically
        panL.setAttribute('transform', `translate(-160 0) rotate(${(-angle).toFixed(2)})`);
        panR.setAttribute('transform', `translate(160 0) rotate(${(-angle).toFixed(2)})`);

        const over = G > D;
        root.dataset.state = over ? (D === 0 ? 'barren' : 'pressure') : 'forest';
        const visibleBlades = Math.ceil(D / +drift.max * blades.length);
        blades.forEach((blade, index) => blade.toggleAttribute('data-visible', index < visibleBlades));
        presets.forEach((button) => button.setAttribute('aria-pressed', String(D === presetValue(button.dataset.kdPreset!))));
        verdict.style.setProperty('--pi-v', over ? '#a78bfa' : '#4FB6A5');
        verdict.innerHTML = over && D === 0
          ? '<strong>No drift kelp.</strong> With no loose blades to eat, urchins may graze attached kelp. The barren shows one possible outcome of sustained grazing, not an immediate or inevitable shift.'
          : over
          ? '<strong>Less drift than the urchins could eat.</strong> Urchins may graze attached kelp. In the study, kelp declined or changed little 91% of the time when estimated grazing exceeded drift supply.'
          : G === 0
            ? '<strong>No grazing at this setting.</strong> Increase urchin biomass to compare the two food supplies.'
            : '<strong>Enough drift to meet estimated grazing demand.</strong> Urchins can feed on loose blades instead of attached kelp. In the study, kelp declined or changed little 42% of the time when drift exceeded estimated grazing.';
        ratio.textContent = G + D > 0
          ? `Balance (grazing − drift) / (grazing + drift) = ${prop.toFixed(2)}.`
          : 'The balance index is undefined when both rates are zero.';
      };

      const setDrift = (mode: string) => {
        drift.value = String(presetValue(mode));
        update();
      };
      presets.forEach((button) => button.addEventListener('click', () => {
        stop();
        setDrift(button.dataset.kdPreset!);
      }));
      play.addEventListener('click', () => {
        if (root.hasAttribute('data-playing')) return stop();
        root.dataset.playing = '';
        play.textContent = 'Stop comparison';
        play.setAttribute('aria-pressed', 'true');
        setDrift('more');
        timer = window.setTimeout(() => {
          if (!root.isConnected) return stop();
          drift.value = '0';
          update();
          timer = window.setTimeout(stop, 4200);
        }, 3600);
      });
      [purple, red, drift].forEach((el) => el.addEventListener('input', () => {
        stop();
        update();
      }));
      update();
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
