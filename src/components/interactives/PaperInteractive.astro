---
/**
 * Picks the interactive for a paper by its DOI. Papers without one render nothing.
 * Keyed by DOI (not slug) because news slugs are regenerated from analysis files.
 * Bespoke components (built from a paper's own model) take precedence; everything
 * else comes from src/data/interactives.json via DataInteractive.
 */
import KelpDetritusBalance from './KelpDetritusBalance.astro';
import CoralWoundHealing from './CoralWoundHealing.astro';
import CarnivoreRecoveryGrid from './CarnivoreRecoveryGrid.astro';
import DataInteractive from './DataInteractive.astro';
import { findInteractive } from '@data/interactives';

interface Props {
  doiUrl?: string;
}
const { doiUrl } = Astro.props;
const doi = (doiUrl || '').replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').toLowerCase();

const bespoke: Record<string, any> = {
  '10.1002/ecy.3673': KelpDetritusBalance,
  '10.1098/rsbl.2026.0177': CoralWoundHealing,
  '10.1038/s41598-022-13671-7': CarnivoreRecoveryGrid,
};
const Bespoke = bespoke[doi];
const data = Bespoke ? undefined : findInteractive(doiUrl);
---

{Bespoke && <Bespoke />}
{data && <DataInteractive data={data} />}
