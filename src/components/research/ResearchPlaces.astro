---
interface Props { slug?: string; }
const { slug } = Astro.props;
const places = [
  { slug: 'coral-reefs', name: 'Mo‘orea', image: 'moorea', height: 1509, alt: 'North-up pencil-textured map of Mo‘orea, showing its two northern bays and elevation-derived mountain ridges', credit: 'Shom, 2023: coastal topo-bathymetric DEM of Mo‘orea, approximately 20 m grid.', source: 'https://doi.org/10.17183/MNT_COTIER_MOOREA_METEO-FRANCE_20m_WGS84' },
  { slug: 'kelp-forests', name: 'Santa Barbara Channel', image: 'santa-barbara-channel', height: 1201, alt: 'North-up pencil-textured relief map of the Santa Barbara Channel, with the mainland above San Miguel, Santa Rosa, Santa Cruz, and Anacapa islands', credit: 'Terrain Tiles: USGS 3DEP, SRTM, and GMTED2010 elevation sources.', source: 'https://github.com/tilezen/joerd/blob/master/docs/attribution.md' },
].filter(place => !slug || place.slug === slug);
---
<div class:list={['research-places', { single: !!slug }]}>
  {places.map(place => (
    <figure>
      <a class="place-image" href={`/images/research/${place.image}-pencil-map.jpg`} aria-label={`Open full-size ${place.name} pencil map`}>
        <img src={`/images/research/${place.image}-pencil-map.jpg`} alt={place.alt} width="1800" height={place.height} loading="lazy" />
      </a>
      <figcaption>
        <h3>{place.name}</h3>
        <p><a href={place.source}>{place.credit}</a> Coastlines: <a href="https://www.soest.hawaii.edu/pwessel/gshhg/">GSHHG</a>. Regional illustration, not a sampling-site or navigation map.</p>
      </figcaption>
    </figure>
  ))}
</div>
<style>
  .research-places { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; background: #fff; color: #293f3b; padding: 24px; margin-block: 32px; }
  .single { grid-template-columns: minmax(0, 1fr); max-width: 960px; margin-inline: auto; }
  figure { min-width: 0; margin: 0; }
  .place-image { display: block; }
  img { display: block; width: 100%; height: auto; }
  figcaption { padding: 16px 8px 0; }
  h3 { font: 400 26px/1.3 Georgia, serif; letter-spacing: 0; margin: 0 0 12px; color: #293f3b; }
  p { font-size: 12px; line-height: 1.7; color: #43534c; margin: 0; }
  a { color: #22625c; text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 3px solid #22625c; outline-offset: 4px; }
  @media(min-width: 768px) { .research-places:not(.single) .place-image { aspect-ratio: 1800 / 1509; display: flex; align-items: center; } }
  @media(max-width: 767px) { .research-places { grid-template-columns: minmax(0, 1fr); padding: 16px; gap: 32px; } }
</style>
