---
interface Props {
  /** Fill color of the wave (the color the wave transitions TO - typically the next section's bg) */
  fillColor?: 'surface' | 'navy-deep' | 'paper' | 'paper-surface';
  /** Unique ID for this wave instance (for gradient IDs) */
  id?: string;
}

const {
  fillColor = 'paper',
  id = 'wave'
} = Astro.props;

// Paper-theme aware. Defaults are now cream paper, but the legacy
// 'surface' / 'navy-deep' values still resolve so any caller that
// hasn't migrated still renders a sensible wave.
const fillColorValue = {
  'surface': '#F4EFE6',
  'navy-deep': '#0F2942',
  'paper': '#F4EFE6',
  'paper-surface': '#E8DFD2'
}[fillColor];
---

<div class="wave-divider" data-wave-id={id} aria-hidden="true">
  <!-- Single subtle hairline wave — no animation, no neon gradient.
       Editorial restraint: this is a single tonal step between sections,
       not a glowing ocean. -->
  <svg
    class="wave-svg"
    viewBox="0 0 2880 60"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      fill={fillColorValue}
      d="M0,30 C480,50 960,10 1440,30 C1920,50 2400,10 2880,30 L2880,60 L0,60 Z"
    />
  </svg>
</div>

<style>
  .wave-divider {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 30px;
    overflow: hidden;
    line-height: 0;
    transform: translateY(1px);
    z-index: 2;
  }

  .wave-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 768px) {
    .wave-divider {
      height: 40px;
    }
  }
</style>
