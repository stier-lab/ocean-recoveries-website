---
import Layout from '@layouts/Layout.astro';
import WaveDivider from '@components/shared/WaveDivider.astro';
import { posts } from '@data/posts';
import { currentTeam } from '@data/team';

// Get 3 most recent news posts
const recentPosts = [...posts]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// Get team members for preview (first 4)
const teamPreview = [...currentTeam]
  .sort((a, b) => a.order - b.order)
  .slice(0, 4);

// Format date helper
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<Layout
  title="Ocean Recoveries Lab | Engineering Resilience from Organisms to Ecosystems"
  description="Research lab at UC Santa Barbara identifying ecological bottlenecks and thresholds that trap coral reefs and kelp forests in degraded states—and turning that science into decision tools for restoration."
  keywords={['Ocean Recoveries Lab', 'coral reef research', 'kelp forest ecology', 'marine conservation', 'UC Santa Barbara', 'Adrian Stier', 'ecosystem resilience', 'restoration ecology']}
>
  <!-- Hero Section - Simplified & More Impactful -->
  <section class="hero">
    <div class="hero-media">
      <div class="hero-image" style="background-image: url('/images/coral-reef-panorama-anthias-fish.jpeg');"></div>
      <div class="hero-overlay"></div>
      <div class="hero-text-scrim"></div>
      <div class="hero-grain"></div>
      <!-- Subtle animated particles -->
      <div class="hero-particles" aria-hidden="true">
        <div class="particle particle-1"></div>
        <div class="particle particle-2"></div>
        <div class="particle particle-3"></div>
        <div class="particle particle-4"></div>
        <div class="particle particle-5"></div>
      </div>
    </div>

    <div class="hero-content">
      <div class="container">
        <div class="hero-text-block">
          <!-- Compact headline lockup -->
          <div class="hero-title-block scroll-reveal stagger-1">
            <h1 class="hero-title">
              <span class="title-main">Ocean <span class="title-serif">Recoveries</span></span>
              <span class="title-lab">Lab</span>
            </h1>
          </div>

          <!-- Tagline - LARGER and more prominent -->
          <div class="hero-tagline-wrapper scroll-reveal stagger-2">
            <p class="hero-tagline">
              Understanding <em>collapse</em>.<br />
              Designing <em>recovery</em>.
            </p>
          </div>

          <!-- Simplified thesis - shorter -->
          <p class="hero-desc scroll-reveal stagger-3">
            We identify the ecological bottlenecks that trap coral reefs and kelp forests in degraded states—and turn that science into decision tools for restoration.
          </p>

          <!-- Actions row -->
          <div class="hero-actions scroll-reveal stagger-4">
            <a href="#approach" class="btn-hero-primary">
              <span>How We Work</span>
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/publications" class="btn-hero-secondary">View Publications</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="scroll-cue">
      <div class="scroll-cue-line"></div>
    </div>

    <WaveDivider id="hero-wave" fillColor="surface" />
  </section>

  <!-- How We Work Section - More Visual -->
  <section id="approach" class="approach-section">
    <div class="container">
      <!-- Intro block -->
      <div class="approach-intro scroll-reveal">
        <div class="approach-header">
          <span class="approach-eyebrow">Our Approach</span>
          <h2 class="approach-headline">
            How We <span class="approach-headline-emphasis">Work</span>
          </h2>
        </div>
        <p class="approach-thesis">
          We run experiments, synthesize evidence across systems, and build models that translate results into actionable thresholds and decision tools.
        </p>
      </div>

      <!-- Method cards with numbers -->
      <div class="approach-grid">
        <div class="approach-card scroll-reveal stagger-1">
          <div class="card-number">01</div>
          <div class="approach-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
            </svg>
          </div>
          <h3 class="approach-title">Field Experiments</h3>
          <p class="approach-desc">
            Test mechanisms in the field by manipulating key species interactions and quantifying effects on ecosystem recovery.
          </p>
          <div class="approach-example">
            <span class="example-label">Example:</span>
            <span>Guard crab exclusion experiments on coral colonies</span>
          </div>
        </div>

        <div class="approach-card scroll-reveal stagger-2">
          <div class="card-number">02</div>
          <div class="approach-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75l-9.75-5.25 4.179-2.25m11.142 0l-5.571 3-5.571-3" />
            </svg>
          </div>
          <h3 class="approach-title">Evidence Synthesis</h3>
          <p class="approach-desc">
            Systematic review and meta-analysis to compare recovery drivers across ecosystems and estimate robust effect sizes.
          </p>
          <div class="approach-example">
            <span class="example-label">Example:</span>
            <span>Global analysis of coral recovery trajectories</span>
          </div>
        </div>

        <div class="approach-card scroll-reveal stagger-3">
          <div class="card-number">03</div>
          <div class="approach-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="5" r="2" />
              <circle cx="5" cy="19" r="2" />
              <circle cx="19" cy="19" r="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v4m0 0l-5 6m5-6l5 6" />
            </svg>
          </div>
          <h3 class="approach-title">Predictive Modeling</h3>
          <p class="approach-desc">
            Theory and simulation models that translate field data into thresholds and decision-support tools for managers.
          </p>
          <div class="approach-example">
            <span class="example-label">Output:</span>
            <span>Urchin barren risk indicators for MPAs</span>
          </div>
        </div>
      </div>

      <!-- Unifying question as callout -->
      <div class="approach-question scroll-reveal">
        <div class="question-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
          </svg>
        </div>
        <p class="question-text">
          <span class="question-prefix">One question drives everything:</span>
          How can we engineer ecosystem resilience in a rapidly changing world?
        </p>
      </div>
    </div>

    <!-- Gradient transition instead of wave -->
    <div class="section-fade-dark"></div>
  </section>

  <!-- Field Sites Section -->
  <section id="field-sites" class="field-sites">
    <div class="field-sites-bg">
      <div class="field-sites-gradient"></div>
    </div>

    <div class="container relative z-10">
      <div class="sites-intro scroll-reveal">
        <span class="sites-eyebrow">Field Sites</span>
        <h2 class="sites-headline">
          Where We <span class="sites-headline-emphasis">Work</span>
        </h2>
        <p class="sites-thesis">
          A volcanic island lagoon. A temperate kelp forest coastline. Same questions about resilience—different ecosystems, transferable insights.
        </p>
      </div>

      <!-- Field Site Cards -->
      <div class="sites-grid">
        <!-- Mo'orea Coral Reefs -->
        <a href="/research/coral-reefs" class="site-card site-card-coral scroll-reveal stagger-1">
          <div class="site-image">
            <img src="/images/cauliflower-coral-damselfish-reef.jpeg" alt="Coral reef ecosystem in Mo'orea" loading="lazy" />
            <div class="site-overlay"></div>
          </div>
          <div class="site-content">
            <div class="site-header">
              <div class="site-location">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span>Mo'orea, French Polynesia</span>
              </div>
              <span class="site-badge site-badge-coral">MCR LTER</span>
            </div>
            <h3 class="site-title">Coral Reefs</h3>
            <p class="site-dynamics">Species interactions that accelerate or impede coral recovery</p>

            <div class="site-research">
              <h4 class="research-heading">Key mechanisms:</h4>
              <ul class="research-list">
                <li>Fish-coral mutualisms and nutrient subsidies</li>
                <li>Guard crabs defending against crown-of-thorns</li>
                <li>Priority effects in community reassembly</li>
              </ul>
            </div>

            <div class="site-cta">
              <span>Explore coral research</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
          <div class="site-accent"></div>
        </a>

        <!-- Santa Barbara Kelp Forests -->
        <a href="/research/kelp-forests" class="site-card site-card-kelp scroll-reveal stagger-2">
          <div class="site-image">
            <img src="/images/giant-kelp-sunlight-underwater.jpeg" alt="Kelp forest ecosystem in Santa Barbara" loading="lazy" />
            <div class="site-overlay"></div>
          </div>
          <div class="site-content">
            <div class="site-header">
              <div class="site-location">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span>Santa Barbara, California</span>
              </div>
              <span class="site-badge site-badge-kelp">SBC LTER</span>
            </div>
            <h3 class="site-title">Kelp Forests</h3>
            <p class="site-dynamics">Predator control of urchin barrens and ecosystem tipping points</p>

            <div class="site-research">
              <h4 class="research-heading">Key mechanisms:</h4>
              <ul class="research-list">
                <li>Lobster-urchin size thresholds for kelp persistence</li>
                <li>MPA spillover and fishery interactions</li>
                <li>Thermal limits on predator effectiveness</li>
              </ul>
            </div>

            <div class="site-cta">
              <span>Explore kelp research</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
          <div class="site-accent"></div>
        </a>
      </div>

      <!-- LTER Badge -->
      <div class="lter-badge scroll-reveal">
        <span class="lter-text">Backed by decades of</span>
        <span class="lter-highlight">NSF Long Term Ecological Research</span>
        <span class="lter-text">data at both sites</span>
      </div>
    </div>

    <WaveDivider id="sites-wave" fillColor="surface" />
  </section>

  <!-- Recent Work Section - Enhanced Featured Article -->
  <section class="news-section">
    <div class="container">
      <div class="news-header scroll-reveal">
        <div class="news-intro">
          <span class="news-eyebrow">Recent Work</span>
          <h2 class="news-headline">
            Latest <span class="news-headline-emphasis">Research</span>
          </h2>
        </div>
        <a href="/publications" class="btn-outline-editorial-dark hidden sm:inline-flex">
          <span>All publications</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Featured Article - Full Width -->
      {recentPosts[0] && (
        <article class="news-featured scroll-reveal">
          <a href={`/news/${recentPosts[0].slug}`} class="featured-link">
            <div class="featured-image">
              <img src={recentPosts[0].featuredImage} alt={recentPosts[0].title} loading="eager" />
              <div class="featured-overlay"></div>
            </div>
            <div class="featured-content">
              <div class="featured-meta">
                <time class="featured-date">{formatDate(recentPosts[0].date)}</time>
                <span class="featured-category">{recentPosts[0].tags[0]}</span>
              </div>
              <h3 class="featured-title">{recentPosts[0].title}</h3>
              <p class="featured-excerpt">{recentPosts[0].excerpt}</p>
              <span class="featured-cta">
                Read the full story
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        </article>
      )}

      <!-- Secondary Articles Grid -->
      <div class="news-grid">
        {recentPosts.slice(1).map((post, i) => (
          <article class={`news-card scroll-reveal stagger-${i + 1}`}>
            <a href={`/news/${post.slug}`} class="news-link">
              <div class="news-image">
                <img src={post.featuredImage} alt={post.title} loading="lazy" />
                <div class="news-image-overlay"></div>
              </div>
              <div class="news-body">
                <div class="news-meta">
                  <time class="news-date">{formatDate(post.date)}</time>
                  <span class="news-category">{post.tags[0]}</span>
                </div>
                <h3 class="news-title">{post.title}</h3>
                <span class="news-read-more">
                  Read more
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="news-mobile-link scroll-reveal sm:hidden">
        <a href="/publications" class="btn-outline-editorial-dark">View All Publications</a>
      </div>
    </div>

    <!-- Gradient transition -->
    <div class="section-fade-dark"></div>
  </section>

  <!-- Team Section - Balanced with Visual -->
  <section class="team-section">
    <div class="team-bg">
      <div class="team-gradient"></div>
    </div>

    <div class="container relative z-10">
      <div class="team-layout">
        <!-- Left: Content -->
        <div class="team-content scroll-reveal">
          <span class="team-eyebrow">The Team</span>
          <h2 class="team-headline">
            Who We <span class="team-headline-emphasis">Are</span>
          </h2>
          <p class="team-text">
            An interdisciplinary group combining field ecology, quantitative modeling, and restoration science—working in Mo'orea and Santa Barbara.
          </p>

          <!-- Inline stats -->
          <div class="team-stats-inline">
            <div class="stat-item">
              <span class="stat-value">75+</span>
              <span class="stat-label">publications</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-value">15</span>
              <span class="stat-label">years field research</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-value">2</span>
              <span class="stat-label">LTER sites</span>
            </div>
          </div>

          <!-- What makes us different -->
          <div class="team-differentiators">
            <div class="differentiator">
              <span class="diff-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </span>
              <span class="diff-text">Decades of baseline data at each site</span>
            </div>
            <div class="differentiator">
              <span class="diff-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </span>
              <span class="diff-text">Theory-driven experimental design</span>
            </div>
            <div class="differentiator">
              <span class="diff-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </span>
              <span class="diff-text">Outputs for managers, not just papers</span>
            </div>
          </div>

          <a href="/people" class="btn-editorial-primary btn-editorial-light">
            <span class="btn-text">Meet the Full Team</span>
            <span class="btn-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        </div>

        <!-- Right: Team Preview Grid -->
        <div class="team-preview scroll-reveal">
          <div class="team-preview-grid">
            {teamPreview.map((member, i) => (
              <a href="/people" class={`team-preview-card stagger-${i + 1}`}>
                <div class="preview-image">
                  {member.image && !member.image.includes('placeholder') ? (
                    <img src={member.image} alt={member.name} loading="lazy" />
                  ) : (
                    <div class="preview-placeholder">
                      <span>{member.name.charAt(0)}</span>
                    </div>
                  )}
                </div>
                <div class="preview-info">
                  <span class="preview-name">{member.name}</span>
                  <span class="preview-role">{member.title}</span>
                </div>
              </a>
            ))}
          </div>
          <p class="team-preview-more">+ {currentTeam.length - 4} more team members</p>
        </div>
      </div>
    </div>

    <WaveDivider id="team-wave" fillColor="surface" />
  </section>

  <!-- Funders/Partners Section - Credibility Strip -->
  <section class="funders-section">
    <div class="container">
      <div class="funders-content scroll-reveal">
        <span class="funders-label">Research supported by</span>
        <div class="funders-strip">
          <a href="https://www.nsf.gov/" target="_blank" rel="noopener noreferrer" class="funder-item" title="National Science Foundation">
            <span class="funder-abbrev">NSF</span>
            <span class="funder-full">National Science Foundation</span>
          </a>
          <span class="funder-divider"></span>
          <a href="https://www.wmkeck.org/" target="_blank" rel="noopener noreferrer" class="funder-item" title="W.M. Keck Foundation">
            <span class="funder-abbrev">Keck</span>
            <span class="funder-full">W.M. Keck Foundation</span>
          </a>
          <span class="funder-divider"></span>
          <a href="https://www.opc.ca.gov/" target="_blank" rel="noopener noreferrer" class="funder-item" title="California Ocean Protection Council">
            <span class="funder-abbrev">OPC</span>
            <span class="funder-full">CA Ocean Protection Council</span>
          </a>
          <span class="funder-divider"></span>
