---
import Layout from '@layouts/Layout.astro';
import WaveDivider from '@components/shared/WaveDivider.astro';
import { posts } from '@data/posts';

// Get 3 most recent news posts
const recentPosts = [...posts]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// Format date helper
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<Layout
  title="Ocean Recoveries Lab | Engineering Resilience from Organisms to Ecosystems"
  description="Research lab at UC Santa Barbara identifying ecological bottlenecks and thresholds that trap coral reefs and kelp forests in degraded states—and turning that science into decision tools for restoration."
  keywords={['Ocean Recoveries Lab', 'coral reef research', 'kelp forest ecology', 'marine conservation', 'UC Santa Barbara', 'Adrian Stier', 'ecosystem resilience', 'restoration ecology']}
>
  <!-- Hero Section - Thesis + Mechanism + Output -->
  <section class="hero">
    <div class="hero-media">
      <div class="hero-image" style="background-image: url('/images/coral-reef-panorama-anthias-fish.jpeg');"></div>
      <div class="hero-overlay"></div>
      <div class="hero-grain"></div>
    </div>

    <div class="hero-content">
      <div class="container">
        <!-- Editorial masthead -->
        <div class="hero-masthead scroll-reveal">
          <div class="masthead-line"></div>
          <span class="masthead-text">UC Santa Barbara</span>
          <div class="masthead-line"></div>
        </div>

        <!-- Main title - 2 lines, only Recoveries stylized -->
        <div class="hero-title-block">
          <h1 class="hero-title scroll-reveal stagger-1">
            <span class="title-line title-line-1">Ocean <span class="title-serif">Recoveries</span></span>
            <span class="title-line title-line-2">Lab</span>
          </h1>
        </div>

        <!-- Tagline - the slogan -->
        <div class="hero-tagline-wrapper scroll-reveal stagger-2">
          <div class="tagline-accent"></div>
          <p class="hero-tagline">
            Understanding <em>collapse</em>.<br />
            Designing <em>recovery</em>.
          </p>
        </div>

        <!-- Thesis statement - mechanism + output (not just mission) -->
        <p class="hero-desc scroll-reveal stagger-3">
          We identify the ecological bottlenecks and thresholds that trap coral reefs and kelp forests in degraded states—and turn that science into decision tools for restoration and management across the Pacific.
        </p>

        <!-- Credibility line -->
        <p class="hero-credibility scroll-reveal stagger-3">
          Two decades of experiments across coral and kelp ecosystems.
        </p>

        <!-- Actions row -->
        <div class="hero-actions scroll-reveal stagger-4">
          <a href="#approach" class="btn-editorial-primary">
            <span class="btn-text">How We Work</span>
            <span class="btn-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
          <a href="/publications" class="btn-editorial-secondary">View Publications</a>
        </div>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="scroll-cue">
      <div class="scroll-cue-line"></div>
    </div>

    <WaveDivider id="hero-wave" fillColor="surface" />
  </section>

  <!-- How We Work Section - Approach BEFORE geography -->
  <section id="approach" class="approach-section">
    <div class="container">
      <!-- Intro block with unifying question directly below -->
      <div class="approach-intro scroll-reveal">
        <div class="approach-header">
          <span class="approach-eyebrow">Methods</span>
          <h2 class="approach-headline">
            How We <span class="approach-headline-emphasis">Work</span>
          </h2>
        </div>
        <p class="approach-thesis">
          We run experiments, synthesize evidence across systems, and build models that translate results into actionable thresholds and decision tools.
        </p>
        <!-- Unifying question as slim callout -->
        <div class="approach-question">
          <span class="question-arrow">→</span>
          <p class="question-inline">
            <span class="question-prefix">One question drives everything:</span>
            How can we engineer ecosystem resilience in a rapidly changing world?
          </p>
        </div>
      </div>

      <!-- Three method cards as "answers" -->
      <div class="approach-grid">
        <div class="approach-card scroll-reveal stagger-1">
          <div class="approach-icon">
            <!-- Flask icon for experiments -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
            </svg>
          </div>
          <h3 class="approach-title">Experiments</h3>
          <ul class="approach-list">
            <li><span class="list-what">Test mechanisms in the field</span></li>
            <li><span class="list-how">Manipulate key interactions</span></li>
            <li><span class="list-why">Quantify effects on recovery</span></li>
          </ul>
        </div>

        <div class="approach-card scroll-reveal stagger-2">
          <div class="approach-icon">
            <!-- Layers/stack icon for synthesis -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75l-9.75-5.25 4.179-2.25m11.142 0l-5.571 3-5.571-3" />
            </svg>
          </div>
          <h3 class="approach-title">Synthesis</h3>
          <ul class="approach-list">
            <li><span class="list-what">Systematic review & meta-analysis</span></li>
            <li><span class="list-how">Compare across ecosystems</span></li>
            <li><span class="list-why">Estimate robust effect sizes</span></li>
          </ul>
        </div>

        <div class="approach-card scroll-reveal stagger-3">
          <div class="approach-icon">
            <!-- Network/nodes icon for predictive models -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="5" r="2" />
              <circle cx="5" cy="19" r="2" />
              <circle cx="19" cy="19" r="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v4m0 0l-5 6m5-6l5 6" />
            </svg>
          </div>
          <h3 class="approach-title">Modeling</h3>
          <ul class="approach-list">
            <li><span class="list-what">Theory, simulation & statistical models</span></li>
            <li><span class="list-how">Translate data into thresholds</span></li>
            <li><span class="list-why">Generate decision-support tools</span></li>
          </ul>
        </div>
      </div>

    </div>

    <WaveDivider id="approach-wave" fillColor="navy-deep" />
  </section>

  <!-- Field Sites Section - Now as context, not first -->
  <section id="field-sites" class="field-sites">
    <div class="field-sites-bg">
      <div class="field-sites-gradient"></div>
    </div>

    <div class="container relative z-10">
      <div class="sites-intro scroll-reveal">
        <span class="sites-eyebrow">Field Sites</span>
        <h2 class="sites-headline">
          In the <span class="sites-headline-emphasis">Field</span>
        </h2>
        <p class="sites-thesis">
          A volcanic island lagoon. A temperate kelp forest coastline. Same questions about resilience and recovery—different ecosystems, transferable insights. Both backed by decades of NSF Long Term Ecological Research data.
        </p>
      </div>

      <!-- Field Site Cards -->
      <div class="sites-grid">
        <!-- Mo'orea Coral Reefs -->
        <a href="/research/coral-reefs" class="site-card site-card-coral scroll-reveal stagger-1">
          <div class="site-image">
            <img src="/images/cauliflower-coral-damselfish-reef.jpeg" alt="Coral reef ecosystem in Mo'orea" loading="lazy" />
            <div class="site-overlay"></div>
          </div>
          <div class="site-content">
            <div class="site-header">
              <div class="site-location">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span>Mo'orea, French Polynesia</span>
              </div>
              <span class="site-badge site-badge-coral">MCR LTER</span>
            </div>
            <h3 class="site-title">Coral Reefs</h3>
            <p class="site-dynamics">Species interactions that accelerate or impede coral recovery</p>

            <div class="site-research">
              <h4 class="research-heading">Key mechanisms:</h4>
              <ul class="research-list">
                <li>Fish-coral mutualisms and nutrient subsidies</li>
                <li>Guard crabs defending against crown-of-thorns</li>
                <li>Priority effects in community reassembly</li>
              </ul>
            </div>

            <div class="site-output">
              <span class="output-label">Management output:</span>
              <span class="output-text">Restoration strategy evaluation tools for coral recovery</span>
            </div>

            <div class="site-cta">
              <span>Explore coral research</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
          <div class="site-accent"></div>
        </a>

        <!-- Santa Barbara Kelp Forests -->
        <a href="/research/kelp-forests" class="site-card site-card-kelp scroll-reveal stagger-2">
          <div class="site-image">
            <img src="/images/giant-kelp-sunlight-underwater.jpeg" alt="Kelp forest ecosystem in Santa Barbara" loading="lazy" />
            <div class="site-overlay"></div>
          </div>
          <div class="site-content">
            <div class="site-header">
              <div class="site-location">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span>Santa Barbara, California</span>
              </div>
              <span class="site-badge site-badge-kelp">SBC LTER</span>
            </div>
            <h3 class="site-title">Kelp Forests</h3>
            <p class="site-dynamics">Predator control of urchin barrens and ecosystem tipping points</p>

            <div class="site-research">
              <h4 class="research-heading">Key mechanisms:</h4>
              <ul class="research-list">
                <li>Lobster-urchin size thresholds for kelp persistence</li>
                <li>MPA spillover and fishery interactions</li>
                <li>Thermal limits on predator effectiveness</li>
              </ul>
            </div>

            <div class="site-output">
              <span class="output-label">Management output:</span>
              <span class="output-text">Predator-based indicators for urchin barren risk</span>
            </div>

            <div class="site-cta">
              <span>Explore kelp research</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
          <div class="site-accent"></div>
        </a>
      </div>
    </div>

    <WaveDivider id="sites-wave" fillColor="surface" />
  </section>

  <!-- Recent Work Section - Proof after approach -->
  <section class="news-section">
    <div class="container">
      <div class="news-header scroll-reveal">
        <div class="news-intro">
          <span class="news-eyebrow">Recent Work</span>
          <h2 class="news-headline">
            Evidence of <span class="news-headline-emphasis">Impact</span>
          </h2>
        </div>
        <a href="/publications" class="btn-outline-editorial-dark hidden sm:inline-flex">
          <span>All publications</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="news-editorial-grid">
        {recentPosts.map((post, i) => (
          <article class={`news-editorial-card ${i === 0 ? 'news-featured' : ''} scroll-reveal stagger-${i + 1}`}>
            <a href={`/news/${post.slug}`} class="news-editorial-link">
              <div class="news-editorial-image">
                <img src={post.featuredImage} alt={post.title} loading={i === 0 ? 'eager' : 'lazy'} />
                <div class="news-image-overlay"></div>
              </div>
              <div class="news-editorial-body">
                <div class="news-meta">
                  <time class="news-date">{formatDate(post.date)}</time>
                  <span class="news-category">{post.tags[0]}</span>
                </div>
                <h3 class="news-editorial-title">{post.title}</h3>
                {i === 0 && <p class="news-editorial-excerpt">{post.excerpt}</p>}
                <span class="news-read-more">
                  Read more
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="news-mobile-link scroll-reveal sm:hidden">
        <a href="/publications" class="btn-outline-editorial-dark">View All Publications</a>
      </div>
    </div>

    <WaveDivider id="news-wave" fillColor="navy-deep" />
  </section>

  <!-- Team Section - Differentiating the lab -->
  <section class="team-section">
    <div class="team-bg">
      <div class="team-gradient"></div>
    </div>

    <div class="container relative z-10">
      <div class="team-editorial">
        <div class="team-content scroll-reveal">
          <span class="team-eyebrow">The Team</span>
          <h2 class="team-headline">
            Who We <span class="team-headline-emphasis">Are</span>
          </h2>
          <p class="team-text">
            An interdisciplinary group combining field ecology, quantitative modeling, and restoration science—working in Mo'orea and Santa Barbara, collaborating with managers and conservation practitioners.
          </p>

          <!-- Inline stats -->
          <div class="team-stats-inline">
            <span class="stat-inline"><strong>75+</strong> publications</span>
            <span class="stat-divider">•</span>
            <span class="stat-inline"><strong>15</strong> years field research</span>
            <span class="stat-divider">•</span>
            <span class="stat-inline"><strong>2</strong> LTER sites</span>
          </div>

          <!-- What makes us different -->
          <div class="team-differentiators">
            <div class="differentiator">
              <span class="diff-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </span>
              <span class="diff-text">Decades of baseline data at each site</span>
            </div>
            <div class="differentiator">
              <span class="diff-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </span>
              <span class="diff-text">Theory-driven experimental design</span>
            </div>
            <div class="differentiator">
              <span class="diff-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </span>
              <span class="diff-text">Outputs for managers, not just papers</span>
            </div>
          </div>

          <!-- PI Card -->
          <a href="/people" class="pi-editorial-card">
            <img src="/images/adrian.png" alt="Adrian Stier" class="pi-avatar" />
            <div class="pi-details">
              <span class="pi-name">Adrian Stier</span>
              <span class="pi-role">Associate Professor, EEMB</span>
              <span class="pi-bio">Research on reef and kelp dynamics. NSF CAREER awardee.</span>
            </div>
            <svg class="pi-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <a href="/people" class="btn-editorial-primary btn-editorial-light">
            <span class="btn-text">Meet the Full Team</span>
            <span class="btn-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        </div>

      </div>
    </div>

    <WaveDivider id="team-wave" fillColor="surface" />
  </section>

  <!-- Final CTA Section - Segmented Pathways -->
  <section class="final-cta">
    <div class="container">
      <div class="cta-intro scroll-reveal">
        <span class="cta-eyebrow">Get Involved</span>
        <h2 class="cta-headline">
          Work With <span class="cta-headline-emphasis">Us</span>
        </h2>
      </div>

      <!-- Segmented CTA tiles -->
      <div class="cta-tiles">
        <!-- Students -->
        <div class="cta-tile cta-tile-students scroll-reveal stagger-1">
          <div class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
            </svg>
          </div>
          <h3 class="tile-title">Train With Us</h3>
          <p class="tile-desc">
            Undergrads, grad students, and postdocs. Hands-on field work, quantitative training, and co-authorship.
          </p>
          <a href="/join-us" class="tile-link">
            <span>View opportunities</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Collaborators -->
        <div class="cta-tile cta-tile-collab scroll-reveal stagger-2">
          <div class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <h3 class="tile-title">Collaborate</h3>
          <p class="tile-desc">
            Managers and practitioners. We build tools and provide data for restoration planning and MPA evaluation.
          </p>
          <a href="mailto:astier@ucsb.edu" class="tile-link">
            <span>Get in touch</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Support -->
