---
import Layout from '@layouts/Layout.astro';
import { posts } from '@data/posts';
import { currentTeam } from '@data/team';

// Get 3 most recent news posts
const recentPosts = [...posts]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// Get team members for preview (first 4)
const teamPreview = [...currentTeam]
  .sort((a, b) => a.order - b.order)
  .slice(0, 4);

// Format date — long form, editorial
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const issueDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<Layout
  title="Ocean Recoveries Lab | Engineering Resilience from Organisms to Ecosystems"
  description="Research lab at UC Santa Barbara identifying ecological bottlenecks and thresholds that trap coral reefs and kelp forests in degraded states—and turning that science into decision tools for restoration."
  keywords={['Ocean Recoveries Lab', 'coral reef research', 'kelp forest ecology', 'marine conservation', 'UC Santa Barbara', 'Adrian Stier', 'ecosystem resilience', 'restoration ecology']}
>
  <!-- ============================================
       Hero — Editorial masthead
       Cream paper, navy ink, serif headline
       No particles, no Ken Burns, no gradient text
       ============================================ -->
  <section class="hero">
    <div class="container">
      <!-- Masthead bar -->
      <div class="masthead scroll-reveal">
        <span class="masthead-issue">Vol. 01 &middot; {issueDate}</span>
        <span class="masthead-rule"></span>
        <span class="masthead-meta">UC Santa Barbara &middot; Ecology, Evolution &amp; Marine Biology</span>
      </div>

      <div class="hero-grid">
        <!-- Left: typographic hero -->
        <div class="hero-text">
          <p class="hero-kicker scroll-reveal stagger-1">Ocean Recoveries Lab</p>

          <h1 class="hero-title scroll-reveal stagger-1">
            Understanding <em>collapse</em>.<br />
            Designing <em>recovery</em>.
          </h1>

          <p class="hero-deck scroll-reveal stagger-2">
            We identify the ecological bottlenecks that trap coral reefs and kelp forests
            in degraded states&mdash;and turn that science into decision tools for restoration.
          </p>

          <div class="hero-actions scroll-reveal stagger-3">
            <a href="/research/coral-reefs" class="btn btn-primary">
              <span>Explore the research</span>
              <svg class="btn-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/publications" class="btn btn-secondary">View publications</a>
          </div>

          <!-- Editorial byline / dateline -->
          <dl class="hero-meta scroll-reveal stagger-4">
            <div>
              <dt>Principal Investigator</dt>
              <dd>Adrian Stier, PhD</dd>
            </div>
            <div>
              <dt>Field Sites</dt>
              <dd>Mo&apos;orea &middot; Santa Barbara</dd>
            </div>
            <div>
              <dt>Est.</dt>
              <dd><span class="font-mono">2015</span></dd>
            </div>
          </dl>
        </div>

        <!-- Right: editorial photo plate -->
        <figure class="hero-figure scroll-reveal stagger-2">
          <div class="hero-figure-frame">
            <img
              src="/images/coral-reef-panorama-anthias-fish.jpeg"
              alt="Anthias fish over a coral reef in Mo'orea, French Polynesia"
              class="photo-editorial"
              loading="eager"
            />
          </div>
          <figcaption>
            <span class="figcap-label">Plate I</span>
            <span class="figcap-text">
              Anthias schooling above a recovering reef, Mo&apos;orea, French Polynesia.
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============================================
       Section 01 — Approach
       ============================================ -->
  <section id="approach" class="approach">
    <div class="container">
      <div class="section-rule"><span>01 / Approach</span></div>

      <div class="approach-intro scroll-reveal">
        <h2 class="approach-headline">How we work.</h2>
        <p class="lead">
          We run experiments, synthesize evidence across systems, and build models that
          translate results into actionable thresholds and decision tools.
        </p>
      </div>

      <div class="approach-grid">
        <article class="approach-item scroll-reveal stagger-1">
          <span class="approach-num">01</span>
          <h3 class="approach-title">Field Experiments</h3>
          <p class="approach-desc">
            Test mechanisms in the field by manipulating key species interactions and
            quantifying effects on ecosystem recovery.
          </p>
        </article>

        <article class="approach-item scroll-reveal stagger-2">
          <span class="approach-num">02</span>
          <h3 class="approach-title">Evidence Synthesis</h3>
          <p class="approach-desc">
            Systematic review and meta-analysis to compare recovery drivers across
            ecosystems and estimate robust effect sizes.
          </p>
        </article>

        <article class="approach-item scroll-reveal stagger-3">
          <span class="approach-num">03</span>
          <h3 class="approach-title">Predictive Modeling</h3>
          <p class="approach-desc">
            Theory and simulation models that translate field data into thresholds and
            decision-support tools for managers.
          </p>
        </article>
      </div>

      <!-- Pull-quote — the unifying question -->
      <aside class="approach-quote scroll-reveal">
        <p class="pull-quote">
          &ldquo;How can we engineer ecosystem resilience in a rapidly changing world?&rdquo;
        </p>
        <p class="approach-quote-attr">One question drives every project in the lab.</p>
      </aside>
    </div>
  </section>

  <!-- ============================================
       Section 02 — Field Sites
       ============================================ -->
  <section id="field-sites" class="sites">
    <div class="container">
      <div class="section-rule"><span>02 / Field Sites</span></div>

      <div class="sites-intro scroll-reveal">
        <h2 class="sites-headline">Where we work.</h2>
        <p class="lead">
          A volcanic island lagoon. A temperate kelp forest coastline. The same questions
          about resilience&mdash;different ecosystems, transferable insights.
        </p>
      </div>

      <div class="sites-grid">
        <!-- Mo'orea -->
        <a href="/research/coral-reefs" class="site scroll-reveal stagger-1">
          <figure class="site-figure img-zoom">
            <img
              src="/images/cauliflower-coral-damselfish-reef.jpeg"
              alt="Cauliflower coral and damselfish, Mo'orea reef"
              class="photo-editorial"
              loading="lazy"
            />
          </figure>
          <div class="site-body">
            <div class="site-meta">
              <span class="site-loc font-mono">Mo&apos;orea, French Polynesia</span>
              <span class="badge">MCR LTER</span>
            </div>
            <h3 class="site-title">Coral Reefs</h3>
            <p class="site-deck">
              Species interactions that accelerate or impede coral recovery.
            </p>
            <ul class="site-list">
              <li>Fish&ndash;coral mutualisms and nutrient subsidies</li>
              <li>Guard crabs defending against crown-of-thorns</li>
              <li>Priority effects in community reassembly</li>
            </ul>
            <span class="site-cta">
              Explore coral research
              <svg class="cta-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </a>

        <!-- Santa Barbara -->
        <a href="/research/kelp-forests" class="site scroll-reveal stagger-2">
          <figure class="site-figure img-zoom">
            <img
              src="/images/giant-kelp-sunlight-underwater.jpeg"
              alt="Giant kelp, Santa Barbara Channel"
              class="photo-editorial"
              loading="lazy"
            />
          </figure>
          <div class="site-body">
            <div class="site-meta">
              <span class="site-loc font-mono">Santa Barbara, California</span>
              <span class="badge">SBC LTER</span>
            </div>
            <h3 class="site-title">Kelp Forests</h3>
            <p class="site-deck">
              Predator control of urchin barrens and ecosystem tipping points.
            </p>
            <ul class="site-list">
              <li>Lobster&ndash;urchin size thresholds for kelp persistence</li>
              <li>MPA spillover and fishery interactions</li>
              <li>Thermal limits on predator effectiveness</li>
            </ul>
            <span class="site-cta">
              Explore kelp research
              <svg class="cta-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </a>
      </div>

      <p class="sites-footnote scroll-reveal">
        Backed by decades of <strong>NSF Long Term Ecological Research</strong> data at both sites.
      </p>
    </div>
  </section>

  <!-- ============================================
       Section 03 — Recent Work (Latest Research)
       ============================================ -->
  <section class="news">
    <div class="container">
      <div class="section-rule"><span>03 / Latest Research</span></div>

      <div class="news-header scroll-reveal">
        <h2 class="news-headline">Recent work.</h2>
        <a href="/publications" class="news-all">
          All publications
          <svg class="cta-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="news-tiles">
        {recentPosts.map((post, i) => (
          <article class={`news-tile scroll-reveal stagger-${i + 1}`}>
            <a href={`/news/${post.slug}`} class="news-tile-link">
              <figure class="news-tile-image img-zoom">
                <img
                  src={post.featuredImage}
                  alt={post.title}
                  class="photo-editorial"
                  loading={i === 0 ? "eager" : "lazy"}
                />
              </figure>
              <div class="news-tile-body">
                <div class="news-tile-meta">
                  <time class="news-tile-date">{formatDate(post.date)}</time>
                  <span class="news-tile-cat">{post.tags[0]}</span>
                </div>
                <h3 class="news-tile-title">{post.title}</h3>
                <p class="news-tile-excerpt">{post.excerpt}</p>
                <span class="news-tile-cta">
                  Read more
                  <svg class="cta-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       Section 04 — The Team
       ============================================ -->
  <section class="team">
    <div class="container">
      <div class="section-rule"><span>04 / The Team</span></div>

      <div class="team-layout">
        <div class="team-content scroll-reveal">
          <h2 class="team-headline">Who we are.</h2>
          <p class="lead">
            An interdisciplinary group combining field ecology, quantitative modeling, and
            restoration science&mdash;working in Mo&apos;orea and Santa Barbara.
          </p>

          <!-- Editorial stat block: mono numbers, sans labels -->
          <dl class="stats">
            <div class="stat">
              <dt class="stat-num">75<span class="stat-num-sup">+</span></dt>
              <dd class="stat-tag">Publications</dd>
            </div>
            <div class="stat">
              <dt class="stat-num">15</dt>
              <dd class="stat-tag">Years field research</dd>
            </div>
            <div class="stat">
              <dt class="stat-num">02</dt>
              <dd class="stat-tag">LTER sites</dd>
            </div>
          </dl>

          <ul class="diff-list">
            <li><span class="diff-mark">&mdash;</span> Decades of baseline data at each site</li>
            <li><span class="diff-mark">&mdash;</span> Theory-driven experimental design</li>
            <li><span class="diff-mark">&mdash;</span> Outputs for managers, not just papers</li>
          </ul>

          <a href="/people" class="btn btn-primary team-cta">
            <span>Meet the full team</span>
            <svg class="btn-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="team-preview scroll-reveal">
          <div class="team-preview-grid">
            {teamPreview.map((member, i) => (
              <a href="/people" class={`tp-card stagger-${i + 1}`}>
                <div class="tp-image img-zoom">
                  {member.image && !member.image.includes('placeholder') ? (
                    <img
                      src={member.image}
                      alt={member.name}
                      class="photo-editorial"
                      loading="lazy"
                    />
                  ) : (
                    <div class="tp-placeholder">
                      <span>{member.name.charAt(0)}</span>
                    </div>
                  )}
                </div>
                <div class="tp-info">
                  <span class="tp-name">{member.name}</span>
                  <span class="tp-role">{member.title}</span>
                </div>
              </a>
            ))}
          </div>
          <a href="/people" class="tp-more">+ {currentTeam.length - 4} more team members &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       Section 05 — Funders strip
       ============================================ -->
  <section class="funders">
    <div class="container">
      <div class="section-rule"><span>05 / Support</span></div>

      <div class="funders-content scroll-reveal">
        <p class="funders-label">Research supported by</p>
        <ul class="funders-strip">
          <li><a href="https://www.nsf.gov/" target="_blank" rel="noopener noreferrer" class="funder">
            <span class="funder-abbr">NSF</span>
            <span class="funder-full">National Science Foundation</span>
          </a></li>
          <li><a href="https://www.wmkeck.org/" target="_blank" rel="noopener noreferrer" class="funder">
            <span class="funder-abbr">Keck</span>
            <span class="funder-full">W.M. Keck Foundation</span>
          </a></li>
          <li><a href="https://www.opc.ca.gov/" target="_blank" rel="noopener noreferrer" class="funder">
            <span class="funder-abbr">OPC</span>
            <span class="funder-full">CA Ocean Protection Council</span>
          </a></li>
          <li><a href="https://mcr.lternet.edu/" target="_blank" rel="noopener noreferrer" class="funder">
            <span class="funder-abbr">MCR&middot;LTER</span>
            <span class="funder-full">Moorea Coral Reef</span>
          </a></li>
          <li><a href="https://sbclter.msi.ucsb.edu/" target="_blank" rel="noopener noreferrer" class="funder">
            <span class="funder-abbr">SBC&middot;LTER</span>
            <span class="funder-full">Santa Barbara Coastal</span>
          </a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================
       Section 06 — Get Involved
       Inverted: dark navy "back cover"
       ============================================ -->
  <section class="cta">
    <div class="container">
      <div class="cta-rule"><span>06 / Get Involved</span></div>

      <div class="cta-intro scroll-reveal">
        <h2 class="cta-headline">Work with us.</h2>
      </div>

      <div class="cta-tiles">
        <a href="/join" class="cta-tile scroll-reveal stagger-1">
          <span class="cta-tile-num font-mono">01</span>
          <h3 class="cta-tile-title">Train with us</h3>
          <p class="cta-tile-desc">
            Undergrads, grad students, and postdocs. Hands-on field work, quantitative
            training, and co-authorship opportunities.
          </p>
          <span class="cta-tile-link">View opportunities &rarr;</span>
        </a>

        <a href="mailto:astier@ucsb.edu" class="cta-tile scroll-reveal stagger-2">
          <span class="cta-tile-num font-mono">02</span>
          <h3 class="cta-tile-title">Collaborate</h3>
          <p class="cta-tile-desc">
            Managers and practitioners seeking restoration tools, MPA evaluation data,
            or research partnerships.
          </p>
          <span class="cta-tile-link">Get in touch &rarr;</span>
        </a>

        <a href="/for-funders" class="cta-tile scroll-reveal stagger-3">
          <span class="cta-tile-num font-mono">03</span>
          <h3 class="cta-tile-title">Support research</h3>
          <p class="cta-tile-desc">
            Philanthropic partners enable student training, field expeditions, and
            open-access tool development.
          </p>
          <span class="cta-tile-link">Learn more &rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============================================
     HERO — editorial masthead
     ============================================ */
  .hero {
    @apply relative pt-28 md:pt-36 pb-20 md:pb-28;
    background-color: #F4EFE6;
  }

  .masthead {
    @apply flex items-center gap-4 mb-12 md:mb-16;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(15, 41, 66, 0.2);
  }

  .masthead-issue {
    @apply font-mono text-xs uppercase tracking-[0.2em] text-ink;
  }

  .masthead-rule {
    flex: 1;
    height: 1px;
    background: rgba(15, 41, 66, 0.18);
  }

  .masthead-meta {
    @apply font-mono text-xs uppercase tracking-[0.18em] text-ink/60 hidden md:block;
  }

  .hero-grid {
    @apply grid lg:grid-cols-12 gap-10 lg:gap-12 items-start;
  }

  .hero-text {
    @apply lg:col-span-7;
  }

  .hero-kicker {
    @apply font-mono text-xs uppercase tracking-[0.22em] text-accent mb-6;
  }

  /* The headline — solid ink, no gradient, serif */
  .hero-title {
    @apply font-serif text-ink mb-8;
    font-size: clamp(2.5rem, 1.6rem + 4.2vw, 5.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero-title em {
    font-style: italic;
    font-weight: 500;
    color: #3A6B7A;
  }

  .hero-deck {
    @apply font-sans text-ink/80 mb-10;
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.25rem);
    line-height: 1.65;
    max-width: 38rem;
  }

  .hero-actions {
    @apply flex flex-wrap items-center gap-3 mb-12;
  }

  .btn-arrow {
    @apply w-4 h-4 transition-transform duration-200;
  }

  .btn:hover .btn-arrow {
    transform: translateX(2px);
  }

  .hero-meta {
    @apply grid grid-cols-3 gap-6 pt-8;
    border-top: 1px solid rgba(15, 41, 66, 0.15);
    max-width: 36rem;
  }

  .hero-meta dt {
    @apply font-mono text-[10px] uppercase tracking-[0.18em] text-ink/70 mb-1;
  }

  .hero-meta dd {
    @apply font-sans text-sm text-ink;
  }

  /* Photo plate */
  .hero-figure {
    @apply lg:col-span-5;
  }

  .hero-figure-frame {
    @apply overflow-hidden;
    background: #EDE6D9;
    padding: 0.5rem;
    border: 1px solid rgba(15, 41, 66, 0.12);
  }

  .hero-figure-frame img {
    @apply w-full h-auto;
    /* Landscape crop to match the panorama source. The 4:3 ratio gives
       the figure some vertical presence without forcing a destructive
       portrait crop on a landscape photo. */
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .hero-figure figcaption {
    @apply mt-3 flex gap-3 items-baseline;
    border-top: 1px solid rgba(15, 41, 66, 0.12);
    padding-top: 0.75rem;
  }

  .figcap-label {
    @apply font-mono text-[10px] uppercase tracking-[0.2em] text-accent;
  }

  .figcap-text {
    @apply font-sans text-xs text-ink/85 italic leading-snug;
  }

  /* ============================================
     APPROACH
     ============================================ */
  .approach {
    @apply relative py-24 md:py-32;
  }

  .approach-intro {
    @apply max-w-3xl mb-16;
  }

  .approach-headline {
    @apply font-serif text-ink mb-5;
    font-size: clamp(1.875rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .approach-grid {
    @apply grid md:grid-cols-3 gap-10 md:gap-12 mb-20;
    border-top: 1px solid rgba(15, 41, 66, 0.15);
    padding-top: 2.5rem;
  }

  .approach-item {
    @apply relative;
  }

  .approach-num {
    @apply block font-mono text-xs uppercase tracking-[0.22em] text-accent mb-4;
  }

  .approach-title {
    @apply font-serif text-ink mb-3;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 600;
  }

  .approach-desc {
    @apply font-sans text-ink/75;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .approach-quote {
    @apply max-w-3xl mx-auto py-8;
    text-align: left;
  }

  .approach-quote-attr {
    @apply font-mono text-xs uppercase tracking-[0.18em] text-ink/55 mt-5 ml-6;
  }

  /* ============================================
     SITES
     ============================================ */
  .sites {
    @apply relative py-24 md:py-32;
    background: #EDE6D9;
  }

  .sites-intro {
    @apply max-w-3xl mb-16;
  }

  .sites-headline {
    @apply font-serif text-ink mb-5;
    font-size: clamp(1.875rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .sites-grid {
    @apply grid md:grid-cols-2 gap-10 md:gap-12 mb-12;
  }

  .site {
    @apply block no-underline;
    color: inherit;
    transition: transform 300ms ease;
  }

  .site:hover .site-title {
    color: #3A6B7A;
  }

  .site-figure {
    @apply mb-6;
    background: #F4EFE6;
    padding: 0.5rem;
    border: 1px solid rgba(15, 41, 66, 0.1);
  }

  .site-figure img {
    @apply w-full;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .site-body {
    @apply px-1;
  }

  .site-meta {
    @apply flex flex-wrap items-center gap-3 mb-3;
  }

  .site-loc {
    @apply text-xs uppercase tracking-[0.15em] text-ink/60;
  }

  .site-title {
    @apply font-serif text-ink mb-3;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 600;
    transition: color 200ms ease;
  }

  .site-deck {
    @apply font-sans text-ink/75 italic mb-5;
    font-size: 1rem;
    line-height: 1.55;
    max-width: 40ch;
  }

  .site-list {
    @apply list-none p-0 m-0 mb-6 space-y-2;
  }

  .site-list li {
    @apply font-sans text-sm text-ink/80 leading-relaxed;
    padding-left: 1.5rem;
    position: relative;
  }

  .site-list li::before {
    content: '\2014'; /* em dash */
    position: absolute;
    left: 0;
    color: rgba(58, 107, 122, 0.6);
  }

