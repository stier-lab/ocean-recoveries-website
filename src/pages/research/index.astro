---
import Layout from '@layouts/Layout.astro';
import ResilienceLandscape from '@components/research/ResilienceLandscape.astro';
import CoralHealingPhotos from '@components/research/CoralHealingPhotos.astro';
import ResearchPlaces from '@components/research/ResearchPlaces.astro';
import StudySitesMap from '@components/research/StudySitesMap';
import { studyPrograms } from '@data/studyPrograms';
import { researchArtwork } from '@data/researchArtwork';

const systems = [
  { slug: 'coral-reefs', title: 'Coral reefs', place: 'Mo\u2018orea, the Dominican Republic, and Florida', summaries: [
    'How warming, genetic variation, and injury affect wound closure and rebuilding.',
    'How coral architecture shapes resident communities, and how those animals affect their hosts.',
    'How demographic evidence and simulations can inform restoration choices.',
  ] },
  { slug: 'kelp-forests', title: 'Kelp forests', place: 'Southern California and the Santa Barbara Channel', summaries: [
    'How the history of kelp loss and recovery relates to the communities beneath the canopy.',
    'How fishes and seafloor communities respond to different layers of reef habitat.',
    'When predators, grazers, marine protection, and fishing influence kelp persistence.',
  ] },
];
---

<Layout title="Research" description="Current coral reef and kelp forest research: coral repair, resident communities, restoration decisions, habitat, and food webs.">
  <header class="research-intro">
    <div class="container">
      <p class="eyebrow">Ocean Recoveries Lab · UC Santa Barbara</p>
      <h1>Research</h1>
      <p class="intro-copy">Why do some reefs and forests recover while others change? We study the organisms, interactions, and decisions that shape those outcomes.</p>
      <nav aria-label="Research sections">
        <a href="#current-research" data-astro-reload>Current programs</a>
        <a href="#resilience" data-astro-reload>Resilience</a>
        <a href="#sites" data-astro-reload>Places</a>
        <a href="/notebook">Research notebook</a>
      </nav>
    </div>
  </header>

  <section id="current-research" class="program-guide" aria-labelledby="programs-title">
    <div class="container">
      <span id="systems" class="anchor-alias" aria-hidden="true"></span>
      <p class="eyebrow">Current programs</p>
      <h2 id="programs-title">Two ecosystems. Six connected questions.</h2>
      {systems.map(system => (
        <div class="system-guide">
          <div class="system-copy">
            <h3><a href={`/research/${system.slug}`}>{system.title}</a></h3>
            <p class="place">{system.place}</p>
            <ul>
              {studyPrograms[system.slug].map((program, i) => (
                <li>
                  <a href={`/research/${system.slug}#${program.id}`}>{program.label}</a>
                  <p>{system.summaries[i]}</p>
                </li>
              ))}
            </ul>
          </div>
          <img src={researchArtwork[system.slug]!.src} alt={researchArtwork[system.slug]!.alt} width="1536" height="1024" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <section id="resilience" class="resilience-section" aria-labelledby="resilience-title">
    <div class="container">
      <header class="section-heading">
        <p class="eyebrow">A shared question</p>
        <h2 id="resilience-title">Resistance, recovery, or a different state?</h2>
        <p>Kelp forests can resist disturbance, recover after loss, or shift toward an urchin barren. This conceptual landscape separates those possibilities.</p>
      </header>
      <ResilienceLandscape>
        <div slot="habitats" class="resilience-studies">
          <figure>
            <img src="/images/research/kelp-forest-habitat-pencil.jpg" alt="Pencil drawing of giant kelp above a rocky reef" width="900" height="600" loading="lazy" />
            <figcaption><strong>Kelp forest</strong></figcaption>
          </figure>
          <figure>
            <img src="/images/research/urchin-barren-pencil-v2.jpg" alt="Pencil drawing of purple urchins across a reef with little kelp" width="900" height="600" loading="lazy" />
            <figcaption><strong>Urchin barren</strong></figcaption>
          </figure>
        </div>
      </ResilienceLandscape>
    </div>
  </section>

  <section class="supporting-research">
    <div class="container">
      <details class="research-detail" id="pillars">
        <summary>How we work</summary>
        <p>Field experiments test mechanisms. Evidence synthesis compares results across studies. Statistics, theory, and simulation help us understand processes and compare management options.</p>
        <a href="/#approach">Our three approaches</a>
      </details>
      <details class="research-detail" id="impact">
        <summary>From evidence to restoration decisions</summary>
        <p>Our Restoration Strategy Evaluation work compares choices under uncertain growth, survival, and disturbance. Monitoring helps teams revisit those choices as evidence changes.</p>
        <a href="/research/coral-reefs#restoration-strategy-evaluation">Restoration Strategy Evaluation</a>
      </details>
      <details class="research-detail" id="sites">
        <summary>Research places and maps</summary>
        <ResearchPlaces />
        <details class="station-map">
          <summary>Study-site locations</summary>
          <StudySitesMap client:visible />
        </details>
      </details>
      <details class="research-detail" id="healing-detail">
        <summary>Coral repair under the microscope</summary>
        <CoralHealingPhotos />
      </details>
      <p class="contact-line">Interested in a research collaboration? <a href="mailto:astier@ucsb.edu">Contact Adrian Stier</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .research-intro, .program-guide, .supporting-research { background: #fff; color: #293f3b; }
  .research-intro { padding: 124px 0 36px; }
  .eyebrow { font-size: 12px; color: #52675e; margin: 0 0 16px; }
  h1 { color: #293f3b; font: 400 56px/1.1 Georgia, serif; margin: 0 0 24px; letter-spacing: 0; }
  h2 { color: #293f3b; font: 400 34px/1.2 Georgia, serif; margin: 0 0 24px; letter-spacing: 0; }
  h3 { font: 400 30px/1.2 Georgia, serif; margin: 0 0 8px; letter-spacing: 0; }
  .intro-copy { font-size: 20px; line-height: 1.6; max-width: 680px; color: #43534c; margin-bottom: 28px; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 28px; }
  a { color: #21625b; text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible, summary:focus-visible { outline: 3px solid #328278; outline-offset: 4px; }
  nav a { min-height: 44px; display: inline-flex; align-items: center; font-size: 14px; }
  .program-guide { padding: 28px 0 48px; }
  .system-guide { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 56px; align-items: center; padding: 36px 0; border-top: 1px solid #c5d1ca; }
  .system-copy { min-width: 0; }
  .place { color: #52675e; font-size: 13px; margin: 0 0 24px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { margin-top: 22px; }
  li > a { font-size: 15px; font-weight: 600; display: inline-block; padding: 4px 0; }
  li p { color: #43534c; font-size: 15px; line-height: 1.6; margin: 4px 0 0; }
  .system-guide > img { width: 100%; height: auto; max-height: 380px; object-fit: contain; }
  section[id], details[id], .anchor-alias { scroll-margin-top: 6rem; }
  .resilience-section { background: #0f172a; padding: 56px 0; }
  .section-heading { max-width: 760px; margin: 0 auto 32px; }
  .section-heading h2 { color: #f1f5f9; }
  .section-heading p { color: #cbd5e1; }
  .section-heading .eyebrow { color: #80c8b8; }
  .resilience-studies { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); justify-items: center; }
  .resilience-studies figure { margin: 0; }
  .resilience-studies img { display: block; }
  .resilience-studies figcaption { color: #dce7ed; }
  .supporting-research { padding: 40px 0 56px; }
  .research-detail { border-bottom: 1px solid #c5d1ca; padding: 12px 0; }
  summary { cursor: pointer; min-height: 44px; padding: 10px 0; font-size: 17px; }
  .research-detail > p { color: #43534c; margin: 12px 0 20px; line-height: 1.7; }
  .research-detail > a { display: inline-block; margin-bottom: 20px; }
  .station-map { margin: 20px 0; }
  .contact-line { color: #43534c; margin: 32px 0 0; }
  @media(max-width: 767px) {
    .research-intro { padding-top: 104px; padding-bottom: 20px; }
    h1 { font-size: 44px; }
    h2 { font-size: 28px; }
    h3 { font-size: 27px; }
    .intro-copy { font-size: 18px; }
    .system-guide { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .system-guide > img { max-height: 250px; }
    .resilience-section { padding: 40px 0; }
  }
</style>

<script>
  const revealLinkedDetail = () => {
    if (!location.pathname.replace(/\/$/, '').endsWith('/research') || !location.hash) return;
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!target) return;
    let node: HTMLElement | null = target;
    while (node) {
      if (node instanceof HTMLDetailsElement) node.open = true;
      node = node.parentElement;
    }
    requestAnimationFrame(() => {
      if (target.isConnected) target.scrollIntoView({ block: 'start' });
    });
  };
  const removeDetailListener = () => window.removeEventListener('hashchange', revealLinkedDetail);
  const initDetailLinks = () => {
    removeDetailListener();
    if (location.pathname.replace(/\/$/, '') !== '/research') return;
    window.addEventListener('hashchange', revealLinkedDetail);
    revealLinkedDetail();
  };
  initDetailLinks();
  document.addEventListener('astro:page-load', initDetailLinks);
  document.addEventListener('astro:before-swap', removeDetailListener);
</script>
