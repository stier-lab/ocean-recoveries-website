---
import Layout from '@layouts/Layout.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import { currentTeam, alumni } from '@data/team';

// Sort team by order - PI first, then others
const sortedTeam = [...currentTeam].sort((a, b) => a.order - b.order);
const pi = sortedTeam.find(m => m.role === 'pi');
const teamMembers = sortedTeam.filter(m => m.role !== 'pi');

// Role styling - no more shape symbols
const roleLabels: Record<string, string> = {
  pi: 'Principal Investigator',
  postdoc: 'Postdoctoral Researcher',
  phd: 'PhD Student',
  manager: 'Lab Manager',
  undergrad: 'Undergraduate Researcher',
};

// Role colors for badges
const roleColors: Record<string, string> = {
  postdoc: 'teal',
  phd: 'sky',
  manager: 'violet',
  undergrad: 'rose',
};

// Helper to check if image is a placeholder
const isPlaceholderImage = (image: string) => {
  return image.includes('man-scuba-diver-on-boat') || image.includes('placeholder');
};
---

<Layout
  title="People"
  description="Meet the Ocean Recoveries Lab team - researchers studying coral reef and kelp forest recovery at UC Santa Barbara."
  image="/images/research-team-group-photo-beach.jpeg"
  keywords={['research team', 'marine scientists', 'UCSB researchers', 'ocean ecologists', 'Adrian Stier lab']}
>
  <BreadcrumbSchema items={[{ name: 'People', url: '/people' }]} />

  <!-- PI Hero Section - Left-aligned treatment -->
  {pi && (
    <section class="pi-hero-section" id="team">
      <div class="container">
        <div class="pi-hero scroll-reveal">
          <div class="pi-photo-side">
            <img
              src={pi.image}
              alt={`${pi.name} portrait`}
              class="pi-photo"
              loading="eager"
              width="400"
              height="500"
            />
          </div>

          <div class="pi-content-side">
            <span class="pi-role-label">Principal Investigator</span>
            <h2 class="pi-name">{pi.name}</h2>
            <p class="pi-title">{pi.title}</p>

            <p class="pi-hook">{pi.hook}</p>

            <div class="pi-links">
              {pi.email && (
                <a href={`mailto:${pi.email}`} class="pi-link-primary" aria-label={`Email ${pi.name}`}>
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                  <span>Contact</span>
                </a>
              )}

              {pi.orcid && (
                <a href={`https://orcid.org/${pi.orcid}`} target="_blank" rel="noopener noreferrer" class="pi-link-icon" aria-label="ORCID profile">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 01-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z" />
                  </svg>
                </a>
              )}

              {pi.github && (
                <a href={`https://github.com/${pi.github}`} target="_blank" rel="noopener noreferrer" class="pi-link-icon" aria-label="GitHub profile">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                </a>
              )}

              {pi.website && (
                <a href={pi.website} target="_blank" rel="noopener noreferrer" class="pi-link-icon" aria-label="Personal website">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Team Grid Section -->
  <section class="team-section">
    <div class="container">
      <div class="section-header scroll-reveal">
        <h2 class="section-title">Lab Members</h2>
      </div>

      <div class="team-grid">
        {teamMembers.map((member, i) => {
          const roleColor = roleColors[member.role] || 'sky';
          const placeholder = isPlaceholderImage(member.image);

          return (
            <article class={`team-card scroll-reveal stagger-${(i % 4) + 1}`}>
              <div class="team-card-inner">
                <div class="team-photo-container">
                  {placeholder ? (
                    <div class="team-photo-placeholder">
                      <svg class="silhouette-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                      </svg>
                    </div>
                  ) : (
                    <img
                      src={member.image}
                      alt={`${member.name} portrait`}
                      class="team-photo"
                      loading="lazy"
                      width="400"
                      height="500"
                    />
                  )}
                  <div class="team-photo-overlay"></div>

                  <span class={`team-role-badge role-${roleColor}`}>
                    {roleLabels[member.role]}
                  </span>
                </div>

                <div class="team-info">
                  <h3 class="team-name">{member.name}</h3>
                  <p class="team-hook">{member.hook}</p>

                  <div class="team-actions">
                    {member.email ? (
                      <a href={`mailto:${member.email}`} class="team-contact-btn" aria-label={`Email ${member.name}`}>
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                          <polyline points="22,6 12,13 2,6" />
                        </svg>
                        <span>Contact</span>
                      </a>
                    ) : (
                      <a href="mailto:astier@ucsb.edu" class="team-contact-btn team-contact-secondary" aria-label={`Contact lab about ${member.name}`}>
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                          <polyline points="22,6 12,13 2,6" />
                        </svg>
                        <span>Contact Lab</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Alumni Section - Compressed List -->
  <section class="alumni-section" id="alumni">
    <div class="container">
      <div class="alumni-header scroll-reveal">
        <h2 class="alumni-title">Alumni</h2>
        <p class="alumni-subtitle">Where our former members are now</p>
      </div>

      <div class="alumni-list">
        {alumni.map((alum) => (
          <div class="alumni-item scroll-reveal">
            <div class="alumni-info">
              <span class="alumni-name">{alum.name}</span>
              <span class="alumni-role">{alum.role}, {alum.years}</span>
              {alum.currentPosition && (
                <span class="alumni-current">→ {alum.currentPosition}</span>
              )}
            </div>
            {alum.linkedin && (
              <a
                href={alum.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="alumni-linkedin"
                aria-label={`${alum.name}'s LinkedIn`}
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA Section -->
  <section class="join-section" id="join">
    <div class="join-bg">
      <div class="join-gradient"></div>
    </div>

    <div class="container relative z-10">
      <div class="join-content scroll-reveal">
        <h2 class="join-title">
          Join Our <span class="join-title-accent">Mission</span>
        </h2>
        <p class="join-description">
          We're always looking for curious minds passionate about understanding and restoring ocean ecosystems.
        </p>

        <div class="join-cta-group">
          <a href="/join" class="join-btn-primary">
            <span>View Opportunities</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="mailto:astier@ucsb.edu" class="join-btn-secondary">
            <span>Contact Us</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============================================
     PI Hero Section - Left-aligned
     ============================================ */
  .pi-hero-section {
    @apply relative py-12 bg-surface;
    padding-top: 8rem;
  }

  .pi-hero {
    @apply flex flex-col md:flex-row items-start gap-8 lg:gap-12;
  }

  .pi-photo-side {
    @apply flex-shrink-0;
  }

  .pi-photo {
    @apply w-48 h-60 md:w-56 md:h-72 object-cover rounded-xl;
    @apply shadow-xl;
  }

  .pi-content-side {
    @apply flex-1 py-2;
  }

  .pi-role-label {
    @apply inline-block text-xs font-bold uppercase tracking-wide;
    @apply text-amber-400 mb-3;
  }

  .pi-name {
    @apply text-3xl md:text-4xl font-black text-ink tracking-tight mb-1;
  }

  .pi-title {
    @apply text-sm font-medium text-muted mb-4;
  }

  .pi-hook {
    @apply text-muted leading-relaxed mb-6 max-w-xl;
  }

  .pi-links {
    @apply flex items-center gap-3;
  }

  .pi-link-primary {
    @apply inline-flex items-center gap-2 px-5 py-2.5;
    @apply text-sm font-semibold text-white;
    @apply bg-accent rounded-lg no-underline;
    @apply transition-all duration-200;
  }

  .pi-link-primary:hover {
    @apply bg-accent/90;
    transform: translateY(-2px);
  }

  .pi-link-icon {
    @apply p-2.5 rounded-lg;
    @apply text-muted border border-line/50 bg-surface;
    @apply transition-all duration-200 no-underline;
  }

  .pi-link-icon:hover {
    @apply text-accent border-accent/50 bg-accent/10;
  }

  /* ============================================
     Team Grid Section
     ============================================ */
  .team-section {
    @apply relative py-16 bg-surface;
  }

  .section-header {
    @apply mb-10;
  }

  .section-title {
    @apply text-2xl font-bold text-ink tracking-tight;
  }

  .team-grid {
    @apply grid sm:grid-cols-2 lg:grid-cols-3 gap-6;
  }

  .team-card {
    @apply relative;
  }

  .team-card-inner {
    @apply bg-surface-card rounded-xl overflow-hidden;
    @apply border border-line/50;
    @apply flex flex-col h-full;
    transition: all 400ms ease;
  }

  .team-card:hover .team-card-inner {
    @apply border-line;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.4);
    transform: translateY(-4px);
  }

  .team-photo-container {
    @apply relative overflow-hidden;
    aspect-ratio: 4 / 5;
  }

  .team-photo {
    @apply absolute inset-0 w-full h-full object-cover;
    transition: transform 600ms ease;
  }

  .team-card:hover .team-photo {
    @apply scale-105;
  }

  .team-photo-overlay {
    @apply absolute inset-0;
    background: linear-gradient(180deg, transparent 50%, rgba(15, 23, 42, 0.7) 100%);
  }

  .team-photo-placeholder {
    @apply absolute inset-0 flex items-center justify-center;
    background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%);
  }

  .silhouette-icon {
    @apply w-24 h-24 text-white/10;
  }

  .team-role-badge {
    @apply absolute top-3 left-3 z-20;
    @apply inline-block px-3 py-1.5;
    @apply text-xs font-bold uppercase tracking-wide;
    @apply rounded-full shadow-lg;
  }

  .role-teal {
    @apply bg-teal-500/90 text-white;
  }

  .role-sky {
    @apply bg-sky-500/90 text-white;
  }

  .role-violet {
    @apply bg-violet-500/90 text-white;
  }

  .role-rose {
    @apply bg-rose-500/90 text-white;
  }

  .team-info {
    @apply p-5 flex-1 flex flex-col;
  }

  .team-name {
    @apply text-lg font-bold text-ink mb-2;
  }

  .team-hook {
    @apply text-sm text-muted leading-relaxed mb-4 flex-1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .team-actions {
    @apply mt-auto;
  }

  .team-contact-btn {
    @apply inline-flex items-center gap-2 px-4 py-2;
    @apply text-sm font-semibold text-accent;
    @apply border border-accent/40 rounded-lg bg-accent/5;
    @apply transition-all duration-200 no-underline;
  }

  .team-contact-btn:hover {
    @apply bg-accent text-white border-accent;
  }

  .team-contact-secondary {
    @apply text-muted border-line/50 bg-transparent;
  }

  .team-contact-secondary:hover {
    @apply bg-line/30 text-ink border-line;
  }

  /* ============================================
     Alumni Section - Compressed List
     ============================================ */
  .alumni-section {
    @apply relative py-16 overflow-hidden;
    background: linear-gradient(180deg, #0f172a 0%, #0b1929 100%);
  }

  .alumni-header {
    @apply mb-8;
  }

  .alumni-title {
    @apply text-xl font-bold text-ink tracking-tight mb-1;
  }

  .alumni-subtitle {
    @apply text-sm text-muted;
  }

  .alumni-list {
    @apply grid md:grid-cols-2 lg:grid-cols-3 gap-3;
  }

  .alumni-item {
    @apply flex items-center justify-between gap-3 p-3 rounded-lg;
    @apply border border-transparent;
    @apply transition-all duration-200;
    background: rgba(30, 41, 59, 0.3);
  }

  .alumni-item:hover {
    @apply border-line/30;
    background: rgba(30, 41, 59, 0.5);
  }

  .alumni-info {
    @apply flex flex-col min-w-0;
  }

  .alumni-name {
    @apply text-sm font-semibold text-ink truncate;
  }

  .alumni-role {
    @apply text-xs text-muted-2;
  }

  .alumni-current {
    @apply text-xs text-accent/80 truncate;
  }

  .alumni-linkedin {
    @apply p-2 rounded-lg flex-shrink-0;
    @apply text-muted opacity-50;
    @apply transition-all duration-200 no-underline;
  }

  .alumni-item:hover .alumni-linkedin {
    @apply opacity-100;
  }

  .alumni-linkedin:hover {
    @apply text-[#0077B5] bg-[#0077B5]/10;
  }

  /* ============================================
     Join CTA Section
     ============================================ */
  .join-section {
    @apply relative py-20 overflow-hidden;
  }

  .join-bg {
    @apply absolute inset-0;
  }

  .join-gradient {
    @apply absolute inset-0;
    background: linear-gradient(135deg, #0b1929 0%, #0f172a 50%, #0b2545 100%);
  }

  .join-content {
    @apply text-center max-w-xl mx-auto;
  }

  .join-title {
    @apply text-3xl md:text-4xl font-black text-ink tracking-tight mb-4;
  }

  .join-title-accent {
    @apply bg-gradient-to-r from-accent to-accent-2 bg-clip-text text-transparent;
  }

  .join-description {
    @apply text-muted leading-relaxed mb-8 mx-auto;
  }

  .join-cta-group {
    @apply flex flex-col sm:flex-row items-center justify-center gap-4;
  }

  .join-btn-primary {
    @apply inline-flex items-center gap-2 px-7 py-3.5;
    @apply text-sm font-bold text-white;
    @apply bg-accent rounded-full no-underline;
    @apply shadow-lg shadow-accent/25;
    @apply transition-all duration-300;
  }

  .join-btn-primary:hover {
    @apply bg-accent/90 gap-3;
    box-shadow: 0 20px 40px -12px rgba(56, 189, 248, 0.4);
    transform: translateY(-2px);
  }

  .join-btn-secondary {
    @apply inline-flex items-center gap-2 px-7 py-3.5;
    @apply text-sm font-bold text-ink;
    @apply border-2 border-line rounded-full no-underline;
    @apply transition-all duration-300;
  }

  .join-btn-secondary:hover {
    @apply border-accent text-accent;
  }

  /* ============================================
     Responsive Adjustments
     ============================================ */
  @media (max-width: 768px) {
    .pi-hero-section {
      padding-top: 6rem;
    }

    .pi-hero {
      @apply items-center text-center;
    }

    .pi-content-side {
      @apply text-center;
    }

    .pi-links {
      @apply justify-center;
    }

    .team-photo-container {
      aspect-ratio: 1 / 1;
    }

    .alumni-list {
      @apply grid-cols-1;
    }
  }

  /* ============================================
     Reduced Motion
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
    .team-card:hover .team-card-inner,
    .pi-link-primary:hover,
    .join-btn-primary:hover {
      transform: none;
    }
  }
</style>
