---
import Layout from '@layouts/Layout.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import { currentTeam, alumni } from '@data/team';

// Sort team by order
const sortedTeam = [...currentTeam].sort((a, b) => a.order - b.order);

// Role styling
const roleLabels: Record<string, string> = {
  pi: 'Principal Investigator',
  postdoc: 'Postdoctoral Researcher',
  phd: 'PhD Student',
  manager: 'Lab Manager',
  undergrad: 'Undergraduate Researcher',
};

const roleAccents: Record<string, { bg: string; text: string; glow: string }> = {
  pi: { bg: 'rgba(251, 191, 36, 0.15)', text: '#fbbf24', glow: 'rgba(251, 191, 36, 0.3)' },
  postdoc: { bg: 'rgba(45, 212, 191, 0.15)', text: '#2dd4bf', glow: 'rgba(45, 212, 191, 0.3)' },
  phd: { bg: 'rgba(56, 189, 248, 0.15)', text: '#38bdf8', glow: 'rgba(56, 189, 248, 0.3)' },
  manager: { bg: 'rgba(167, 139, 250, 0.15)', text: '#a78bfa', glow: 'rgba(167, 139, 250, 0.3)' },
  undergrad: { bg: 'rgba(251, 113, 133, 0.15)', text: '#fb7185', glow: 'rgba(251, 113, 133, 0.3)' },
};

// Helper to check if image is a placeholder
const isPlaceholderImage = (image: string) => {
  return image.includes('placeholder') || image.includes('man-scuba-diver-on-boat');
};
---

<Layout
  title="People"
  description="Meet the Ocean Recoveries Lab team - researchers studying coral reef and kelp forest recovery at UC Santa Barbara."
  image="/images/research-team-group-photo-beach.jpeg"
  keywords={['research team', 'marine scientists', 'UCSB researchers', 'ocean ecologists', 'Adrian Stier lab']}
>
  <BreadcrumbSchema items={[{ name: 'People', url: '/people' }]} />

  <!-- Team Grid Section -->
  <section class="team-section" id="team">
    <!-- Ambient Background -->
    <div class="ambient-bg">
      <div class="ambient-orb ambient-orb-1"></div>
      <div class="ambient-orb ambient-orb-2"></div>
      <div class="ambient-orb ambient-orb-3"></div>
    </div>

    <div class="container">
      <header class="team-header scroll-reveal">
        <div class="header-accent"></div>
        <h1 class="team-title">Our Team</h1>
        <p class="team-subtitle">
          United by rigorous science and grounded optimism.
          <a href="/values" class="values-link">
            <span>Read our values</span>
            <svg class="values-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </p>
      </header>

      <div class="team-grid">
        {sortedTeam.map((member, i) => {
          const placeholder = isPlaceholderImage(member.image);
          const accent = roleAccents[member.role] || roleAccents.phd;

          return (
            <article
              class={`team-card scroll-reveal stagger-${(i % 6) + 1}`}
              style={`--card-accent: ${accent.text}; --card-accent-bg: ${accent.bg}; --card-glow: ${accent.glow};`}
              data-role={member.role}
            >
              <div class="card-glow"></div>
              <div class="card-inner">
                <!-- Image Section -->
                <div class="card-image-section">
                  {placeholder ? (
                    <div class="card-placeholder">
                      <span class="placeholder-initial">{member.name.charAt(0)}</span>
                      <div class="placeholder-ripple"></div>
                    </div>
                  ) : (
                    <div class="card-image-wrap">
                      <img
                        src={member.image}
                        alt={`${member.name} portrait`}
                        class="card-image"
                        loading={i < 3 ? 'eager' : 'lazy'}
                        width="400"
                        height="500"
                      />
                      <div class="image-overlay"></div>
                    </div>
                  )}

                  <!-- Role Badge -->
                  <div class="role-badge">
                    <span class="role-dot"></span>
                    <span class="role-text">{roleLabels[member.role]}</span>
                  </div>

                  <!-- Decorative corner -->
                  <div class="card-corner"></div>
                </div>

                <!-- Content Section -->
                <div class="card-content">
                  <div class="content-inner">
                    <h2 class="card-name">{member.name}</h2>
                    <p class="card-hook">{member.hook}</p>

                    <div class="card-tags">
                      {member.tags.slice(0, 3).map((tag, ti) => (
                        <span class="card-tag" style={`--tag-delay: ${ti * 50}ms`}>{tag}</span>
                      ))}
                    </div>
                  </div>

                  <div class="card-footer">
                    <div class="card-links">
                      {member.email && (
                        <a href={`mailto:${member.email}`} class="card-link" aria-label={`Email ${member.name}`}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                            <path d="M22 6l-10 7L2 6"/>
                          </svg>
                        </a>
                      )}
                      {member.orcid && (
                        <a href={`https://orcid.org/${member.orcid}`} target="_blank" rel="noopener noreferrer" class="card-link" aria-label="ORCID profile">
                          <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 01-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"/>
                          </svg>
                        </a>
                      )}
                      {member.github && (
                        <a href={`https://github.com/${member.github}`} target="_blank" rel="noopener noreferrer" class="card-link" aria-label="GitHub profile">
                          <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                          </svg>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Alumni Section -->
  <section class="alumni-section" id="alumni">
    <div class="alumni-bg">
      <div class="alumni-gradient"></div>
      <div class="alumni-pattern"></div>
    </div>

    <div class="container relative z-10">
      <header class="alumni-header scroll-reveal">
        <span class="alumni-eyebrow">Alumni Network</span>
        <h2 class="alumni-title">Where They Are Now</h2>
        <p class="alumni-subtitle">Our alumni are making waves across academia and industry</p>
      </header>

      <div class="alumni-grid">
        {alumni.map((alum, i) => (
          <article class={`alumni-card scroll-reveal stagger-${(i % 6) + 1}`}>
            <div class="alumni-card-inner">
              <div class="alumni-photo">
                {alum.image ? (
                  <img
                    src={alum.image}
                    alt={`${alum.name} portrait`}
                    loading="lazy"
                    width="200"
                    height="200"
                  />
                ) : (
                  <div class="alumni-photo-placeholder">
                    <span>{alum.name.charAt(0)}</span>
                  </div>
                )}
              </div>

              <div class="alumni-details">
                <h3 class="alumni-name">{alum.name}</h3>
                <p class="alumni-meta">{alum.role} &middot; {alum.years}</p>
                {alum.currentPosition && (
                  <p class="alumni-position">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                    <span>{alum.currentPosition}</span>
                  </p>
                )}
              </div>

              {alum.linkedin && (
                <a
                  href={alum.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="alumni-linkedin"
                  aria-label={`${alum.name}'s LinkedIn`}
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA Section -->
  <section class="join-section" id="join">
    <div class="join-bg">
      <div class="join-gradient"></div>
      <div class="join-glow"></div>
    </div>

    <div class="container relative z-10">
      <div class="join-content scroll-reveal">
        <span class="join-eyebrow">Opportunities</span>
        <h2 class="join-title">
          Join Our <span class="text-gradient">Mission</span>
        </h2>
        <p class="join-description">
          We're always looking for curious minds passionate about understanding and restoring ocean ecosystems.
        </p>

        <div class="join-cta-group">
          <a href="/join" class="join-btn-primary">
            <span>View Opportunities</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="mailto:astier@ucsb.edu" class="join-btn-secondary">
            <span>Contact Us</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============================================
     Ambient Background
     ============================================ */
  .ambient-bg {
    @apply absolute inset-0 overflow-hidden pointer-events-none;
  }

  .ambient-orb {
    @apply absolute rounded-full;
    filter: blur(100px);
    opacity: 0.4;
    animation: float 20s ease-in-out infinite;
  }

  .ambient-orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.3) 0%, transparent 70%);
    top: -200px;
    right: -200px;
    animation-delay: 0s;
  }

  .ambient-orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(45, 212, 191, 0.25) 0%, transparent 70%);
    bottom: 100px;
    left: -150px;
    animation-delay: -7s;
  }

  .ambient-orb-3 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(167, 139, 250, 0.2) 0%, transparent 70%);
    top: 50%;
    right: 10%;
    animation-delay: -14s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -30px) scale(1.05); }
    66% { transform: translate(-20px, 20px) scale(0.95); }
  }

  /* ============================================
     Team Section
     ============================================ */
  .team-section {
    @apply relative pt-28 pb-20;
    background: linear-gradient(180deg, #0f172a 0%, #0b1929 100%);
  }

  .team-header {
    @apply relative mb-14;
  }

  .header-accent {
    @apply absolute -left-4 top-0 w-1 h-full;
    background: linear-gradient(180deg, #38bdf8 0%, #2dd4bf 100%);
    border-radius: 2px;
  }

  .team-title {
    @apply text-fluid-4xl font-black text-ink mb-3;
    letter-spacing: -0.03em;
  }

  .team-subtitle {
    @apply text-muted text-lg flex items-center gap-3 flex-wrap;
  }

  .values-link {
    @apply inline-flex items-center gap-1.5 text-accent no-underline;
    @apply transition-all duration-300;
  }

  .values-link:hover {
    @apply text-accent-2 gap-2.5;
  }

  .values-arrow {
    @apply w-4 h-4 transition-transform duration-300;
  }

  .values-link:hover .values-arrow {
    transform: translateX(4px);
  }

  /* ============================================
     Team Grid
     ============================================ */
  .team-grid {
    @apply grid gap-6;
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
      @apply max-w-sm mx-auto;
    }

    .header-accent {
      @apply hidden;
    }
  }

  /* ============================================
     Team Card
     ============================================ */
  .team-card {
    @apply relative;
    perspective: 1000px;
  }

  .card-glow {
    @apply absolute -inset-px rounded-2xl opacity-0;
    background: linear-gradient(135deg, var(--card-glow) 0%, transparent 50%);
    transition: opacity 0.5s ease;
    z-index: 0;
  }

  .team-card:hover .card-glow {
    opacity: 1;
  }

  .card-inner {
    @apply relative bg-surface-card rounded-2xl overflow-hidden;
    @apply border border-white/5;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }

  .team-card:hover .card-inner {
    @apply border-white/10;
    transform: translateY(-8px);
    box-shadow:
      0 32px 64px -16px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  /* Card Image Section */
  .card-image-section {
    @apply relative overflow-hidden;
    aspect-ratio: 1 / 1.1;
  }

  .card-image-wrap {
    @apply absolute inset-0;
  }

  .card-image {
    @apply w-full h-full object-cover;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .team-card:hover .card-image {
    transform: scale(1.08);
  }

  .image-overlay {
    @apply absolute inset-0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 40%,
      rgba(15, 23, 42, 0.4) 70%,
      rgba(15, 23, 42, 0.95) 100%
    );
  }

  /* Placeholder Avatar */
  .card-placeholder {
    @apply absolute inset-0 flex items-center justify-center;
    background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%);
  }

  .placeholder-initial {
    @apply text-7xl font-black;
    color: var(--card-accent);
    opacity: 0.3;
  }

  .placeholder-ripple {
    @apply absolute inset-0;
    background: radial-gradient(circle at center, var(--card-accent-bg) 0%, transparent 70%);
    animation: pulse-slow 4s ease-in-out infinite;
  }

  @keyframes pulse-slow {
    0%, 100% { transform: scale(0.8); opacity: 0.3; }
    50% { transform: scale(1.2); opacity: 0.1; }
  }

  /* Role Badge */
  .role-badge {
    @apply absolute top-4 left-4 z-10;
    @apply flex items-center gap-2 px-3 py-1.5;
    @apply text-xs font-semibold uppercase tracking-wider;
    background: var(--card-accent-bg);
    color: var(--card-accent);
    border-radius: 6px;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .role-dot {
    @apply w-1.5 h-1.5 rounded-full;
    background: var(--card-accent);
    box-shadow: 0 0 8px var(--card-glow);
  }

  /* Card Corner Decoration */
  .card-corner {
    @apply absolute bottom-0 right-0 w-24 h-24 pointer-events-none;
    background: linear-gradient(135deg, transparent 50%, var(--card-accent-bg) 50%);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .team-card:hover .card-corner {
    opacity: 0.5;
  }

  /* Card Content */
  .card-content {
    @apply p-5;
  }

  .content-inner {
    @apply mb-4;
  }

  .card-name {
    @apply text-xl font-bold text-ink mb-2;
    letter-spacing: -0.01em;
  }

  .card-hook {
    @apply text-sm text-muted/90 leading-relaxed mb-4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    @apply flex flex-wrap gap-2;
  }

  .card-tag {
    @apply px-2.5 py-1 text-xs font-medium;
    @apply bg-white/5 text-muted rounded-md;
    @apply border border-white/5;
    transition: all 0.3s ease;
    transition-delay: var(--tag-delay, 0ms);
  }

  .team-card:hover .card-tag {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.1);
    color: rgba(241, 245, 249, 0.8);
  }

  /* Card Footer */
  .card-footer {
    @apply flex items-center justify-between pt-4;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .card-links {
    @apply flex items-center gap-2;
  }

  .card-link {
    @apply flex items-center justify-center w-9 h-9 rounded-lg no-underline;
    @apply text-muted bg-white/5 border border-white/5;
    @apply transition-all duration-300;
  }

  .card-link svg {
    @apply w-4 h-4;
  }

  .card-link:hover {
    color: var(--card-accent);
    background: var(--card-accent-bg);
    border-color: var(--card-accent);
    transform: translateY(-2px);
  }

  /* ============================================
     Alumni Section
     ============================================ */
  .alumni-section {
    @apply relative py-24;
  }

  .alumni-bg {
    @apply absolute inset-0 pointer-events-none;
  }

  .alumni-gradient {
    @apply absolute inset-0;
    background: linear-gradient(180deg, #0b1929 0%, #0f172a 50%, #0b1929 100%);
  }

  .alumni-pattern {
    @apply absolute inset-0 opacity-5;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(56, 189, 248, 0.3) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(45, 212, 191, 0.3) 0%, transparent 50%);
  }

  .alumni-header {
    @apply text-center mb-14;
  }

  .alumni-eyebrow {
    @apply inline-block px-4 py-1.5 mb-4;
    @apply text-xs font-bold uppercase tracking-[0.2em] text-accent;
    background: rgba(56, 189, 248, 0.1);
    border-radius: 20px;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .alumni-title {
    @apply text-fluid-3xl font-black text-ink mb-4;
    letter-spacing: -0.02em;
  }

  .alumni-subtitle {
    @apply text-muted max-w-md mx-auto;
  }

  .alumni-grid {
    @apply grid gap-4;
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 1024px) {
    .alumni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .alumni-grid {
      grid-template-columns: 1fr;
    }
  }

  .alumni-card {
    @apply relative;
  }

  .alumni-card-inner {
    @apply flex items-center gap-4 p-4 rounded-xl;
    @apply border transition-all;
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.05);
    transition-duration: 400ms;
    backdrop-filter: blur(4px);
  }

  .alumni-card:hover .alumni-card-inner {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateX(8px);
  }

  .alumni-photo {
    @apply w-14 h-14 rounded-full overflow-hidden shrink-0;
    @apply ring-2 ring-white/10;
  }

  .alumni-photo img {
    @apply w-full h-full object-cover;
  }

  .alumni-photo-placeholder {
    @apply w-full h-full flex items-center justify-center;
    @apply bg-surface text-accent/50 text-lg font-bold;
  }

  .alumni-details {
    @apply flex-1 min-w-0;
  }

  .alumni-name {
    @apply text-sm font-bold text-ink truncate;
  }

  .alumni-meta {
    @apply text-xs text-muted-2;
  }

  .alumni-position {
    @apply flex items-center gap-1.5 mt-1 text-xs text-accent;
  }

  .alumni-position svg {
    @apply w-3 h-3 shrink-0;
  }

  .alumni-linkedin {
    @apply p-2.5 rounded-lg shrink-0 no-underline;
    @apply text-muted/40 bg-transparent;
    @apply transition-all duration-300;
  }

  .alumni-linkedin svg {
    @apply w-4 h-4;
  }

  .alumni-card:hover .alumni-linkedin {
    @apply text-muted/70;
  }

  .alumni-linkedin:hover {
    @apply text-[#0077B5] bg-[#0077B5]/10;
  }

  /* ============================================
     Join CTA Section
     ============================================ */
  .join-section {
    @apply relative py-28 overflow-hidden;
  }

  .join-bg {
    @apply absolute inset-0;
  }

  .join-gradient {
    @apply absolute inset-0;
    background: linear-gradient(180deg, #0b1929 0%, #0b2545 50%, #0f172a 100%);
  }

  .join-glow {
    @apply absolute inset-0;
    background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(56, 189, 248, 0.15) 0%, transparent 60%);
  }

  .join-content {
    @apply text-center max-w-2xl mx-auto;
  }

  .join-eyebrow {
    @apply inline-block px-4 py-1.5 mb-6;
