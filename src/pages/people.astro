---
import Layout from '@layouts/Layout.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import { currentTeam, alumni } from '@data/team';

// Sort team by order
const sortedTeam = [...currentTeam].sort((a, b) => a.order - b.order);

// Role styling
const roleLabels: Record<string, string> = {
  pi: 'Principal Investigator',
  postdoc: 'Postdoctoral Researcher',
  phd: 'PhD Student',
  manager: 'Lab Manager',
  undergrad: 'Undergraduate Researcher',
};

// Helper to check if image is a placeholder
const isPlaceholderImage = (image: string) => {
  return image.includes('placeholder');
};
---

<Layout
  title="People"
  description="Meet the Ocean Recoveries Lab team - researchers studying coral reef and kelp forest recovery at UC Santa Barbara."
  image="/images/research-team-group-photo-beach.jpeg"
  keywords={['research team', 'marine scientists', 'UCSB researchers', 'ocean ecologists', 'Adrian Stier lab']}
>
  <BreadcrumbSchema items={[{ name: 'People', url: '/people' }]} />

  <!-- Page Header -->
  <section class="page-header">
    <div class="header-bg">
      <div class="header-gradient"></div>
      <div class="header-texture"></div>
    </div>

    <div class="container relative z-10">
      <div class="header-content scroll-reveal">
        <span class="header-eyebrow">Ocean Recoveries Lab</span>
        <h1 class="header-title">Our <span class="text-gradient">Team</span></h1>
        <p class="header-subtitle">
          United by a shared commitment to rigorous science and grounded optimism.
          <a href="/values" class="values-link">Read our values &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Team Grid - 6 Person Layout -->
  <section class="team-section" id="team">
    <div class="container">
      <div class="team-grid">
        {sortedTeam.map((member, i) => {
          const placeholder = isPlaceholderImage(member.image);
          const isPi = member.role === 'pi';

          return (
            <article class={`team-card scroll-reveal stagger-${(i % 6) + 1} ${isPi ? 'is-pi' : ''}`}>
              <div class="card-inner">
                <div class="card-image-wrap">
                  {placeholder ? (
                    <div class="card-placeholder">
                      <svg class="placeholder-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                      </svg>
                    </div>
                  ) : (
                    <img
                      src={member.image}
                      alt={`${member.name} portrait`}
                      class="card-image"
                      loading={i < 3 ? 'eager' : 'lazy'}
                      width="400"
                      height="500"
                    />
                  )}
                  <div class="card-image-overlay"></div>
                </div>

                <div class="card-content">
                  <span class={`card-role ${isPi ? 'role-pi' : ''}`}>{roleLabels[member.role]}</span>
                  <h2 class="card-name">{member.name}</h2>
                  <p class="card-hook">{member.hook}</p>

                  <div class="card-footer">
                    <div class="card-tags">
                      {member.tags.slice(0, 2).map(tag => (
                        <span class="card-tag">{tag}</span>
                      ))}
                    </div>

                    <div class="card-links">
                      {member.email && (
                        <a href={`mailto:${member.email}`} class="card-link" aria-label={`Email ${member.name}`}>
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                          </svg>
                        </a>
                      )}
                      {member.orcid && (
                        <a href={`https://orcid.org/${member.orcid}`} target="_blank" rel="noopener noreferrer" class="card-link" aria-label="ORCID profile">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 01-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z" />
                          </svg>
                        </a>
                      )}
                      {member.github && (
                        <a href={`https://github.com/${member.github}`} target="_blank" rel="noopener noreferrer" class="card-link" aria-label="GitHub profile">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                          </svg>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Alumni Section -->
  <section class="alumni-section" id="alumni">
    <div class="alumni-bg">
      <div class="alumni-gradient"></div>
    </div>

    <div class="container relative z-10">
      <header class="alumni-header scroll-reveal">
        <span class="alumni-eyebrow">Alumni Network</span>
        <h2 class="alumni-title">Where They Are Now</h2>
        <p class="alumni-subtitle">Our alumni are making waves across academia and industry</p>
      </header>

      <div class="alumni-grid">
        {alumni.map((alum, i) => (
          <article class={`alumni-card scroll-reveal stagger-${(i % 6) + 1}`}>
            <div class="alumni-card-inner">
              <div class="alumni-photo">
                {alum.image ? (
                  <img
                    src={alum.image}
                    alt={`${alum.name} portrait`}
                    loading="lazy"
                    width="200"
                    height="200"
                  />
                ) : (
                  <div class="alumni-photo-placeholder">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                )}
              </div>

              <div class="alumni-details">
                <h3 class="alumni-name">{alum.name}</h3>
                <p class="alumni-meta">{alum.role} &middot; {alum.years}</p>
                {alum.currentPosition && (
                  <p class="alumni-position">
                    <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                    <span>{alum.currentPosition}</span>
                  </p>
                )}
              </div>

              {alum.linkedin && (
                <a
                  href={alum.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="alumni-linkedin"
                  aria-label={`${alum.name}'s LinkedIn`}
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA Section -->
  <section class="join-section" id="join">
    <div class="join-bg">
      <div class="join-gradient"></div>
      <div class="join-pattern"></div>
    </div>

    <div class="container relative z-10">
      <div class="join-content scroll-reveal">
        <span class="join-eyebrow">Opportunities</span>
        <h2 class="join-title">
          Join Our <span class="text-gradient">Mission</span>
        </h2>
        <p class="join-description">
          We're always looking for curious minds passionate about understanding and restoring ocean ecosystems.
        </p>

        <div class="join-cta-group">
          <a href="/join" class="join-btn-primary">
            <span>View Opportunities</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="mailto:astier@ucsb.edu" class="join-btn-secondary">
            <span>Contact Us</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============================================
     Page Header
     ============================================ */
  .page-header {
    @apply relative pt-32 pb-16;
  }

  .header-bg {
    @apply absolute inset-0;
  }

  .header-gradient {
    @apply absolute inset-0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(56, 189, 248, 0.08) 0%, transparent 50%),
      linear-gradient(180deg, #0f172a 0%, #0b1929 100%);
  }

  .header-texture {
    @apply absolute inset-0 opacity-20 pointer-events-none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .header-content {
    @apply text-center max-w-2xl mx-auto;
  }

  .header-eyebrow {
    @apply inline-block text-xs font-bold uppercase tracking-[0.2em] text-accent/80 mb-4;
  }

  .header-title {
    @apply text-fluid-5xl font-black text-ink mb-6;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .header-subtitle {
    @apply text-fluid-lg text-muted leading-relaxed;
  }

  .values-link {
    @apply text-accent no-underline whitespace-nowrap;
    @apply transition-colors duration-200;
  }

  .values-link:hover {
    @apply text-accent-2;
  }

  /* ============================================
     Team Grid - 6 Person Layout
     ============================================ */
  .team-section {
    @apply relative py-16;
    background: #0f172a;
  }

  .team-grid {
    @apply grid gap-6;
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
      @apply max-w-sm mx-auto;
    }
  }

  .team-card {
    @apply relative;
  }

  .card-inner {
    @apply relative bg-surface-card rounded-2xl overflow-hidden;
    @apply border border-line/30;
    transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .team-card:hover .card-inner {
    @apply border-line/60;
    transform: translateY(-6px);
    box-shadow:
      0 24px 48px -12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(56, 189, 248, 0.08);
  }

  .card-image-wrap {
    @apply relative overflow-hidden;
    aspect-ratio: 4 / 5;
  }

  .card-image {
    @apply absolute inset-0 w-full h-full object-cover;
    transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .team-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-image-overlay {
    @apply absolute inset-0;
    background: linear-gradient(
      180deg,
      transparent 20%,
      rgba(15, 23, 42, 0.3) 50%,
      rgba(15, 23, 42, 0.95) 100%
    );
  }

  .card-placeholder {
    @apply absolute inset-0 flex items-center justify-center;
    background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%);
  }

  .placeholder-icon {
    @apply w-20 h-20 text-white/10;
  }

  .card-content {
    @apply absolute bottom-0 left-0 right-0 p-5;
  }

  .card-role {
    @apply inline-block px-2.5 py-1 mb-3 text-xs font-bold uppercase tracking-wider;
    @apply text-accent/90 bg-accent/10 rounded-md;
  }

  .card-role.role-pi {
    @apply text-accent-2 bg-accent-2/10;
  }

  .card-name {
    @apply text-xl font-bold text-ink mb-2;
    letter-spacing: -0.01em;
  }

  .card-hook {
    @apply text-sm text-muted/90 leading-relaxed mb-4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    @apply flex items-center justify-between gap-3;
  }

  .card-tags {
    @apply flex flex-wrap gap-1.5;
  }

  .card-tag {
    @apply px-2 py-0.5 text-xs text-muted-2 bg-surface/50 rounded;
  }

  .card-links {
    @apply flex items-center gap-1.5;
  }

  .card-link {
    @apply p-2 rounded-lg no-underline;
    @apply text-muted bg-surface/50 border border-line/30;
    @apply transition-all duration-200;
  }

  .card-link:hover {
    @apply text-accent bg-accent/10 border-accent/30;
  }

  /* ============================================
     Alumni Section
     ============================================ */
  .alumni-section {
    @apply relative py-20;
  }

  .alumni-bg {
    @apply absolute inset-0 pointer-events-none;
  }

  .alumni-gradient {
    @apply absolute inset-0;
    background: linear-gradient(180deg, #0f172a 0%, #0b1929 50%, #0f172a 100%);
  }

  .alumni-header {
    @apply text-center mb-12;
  }

  .alumni-eyebrow {
    @apply block text-xs font-bold uppercase tracking-[0.2em] text-accent/80 mb-3;
  }

  .alumni-title {
    @apply text-fluid-3xl font-black text-ink mb-3;
  }

  .alumni-subtitle {
    @apply text-muted max-w-md mx-auto;
  }

  .alumni-grid {
    @apply grid gap-4;
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 1024px) {
    .alumni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .alumni-grid {
      grid-template-columns: 1fr;
    }
  }

  .alumni-card {
    @apply relative;
  }

  .alumni-card-inner {
    @apply flex items-center gap-4 p-4 rounded-xl;
    @apply bg-surface-card/50 border border-line/20;
    @apply transition-all duration-300;
  }

  .alumni-card:hover .alumni-card-inner {
    @apply bg-surface-card border-line/40;
    transform: translateX(4px);
  }

  .alumni-photo {
    @apply w-14 h-14 rounded-full overflow-hidden shrink-0;
    @apply ring-2 ring-line/30;
  }

  .alumni-photo img {
    @apply w-full h-full object-cover;
  }

  .alumni-photo-placeholder {
    @apply w-full h-full flex items-center justify-center;
    @apply bg-surface text-muted-2;
  }

  .alumni-photo-placeholder svg {
    @apply w-7 h-7;
  }

  .alumni-details {
    @apply flex-1 min-w-0;
  }

  .alumni-name {
    @apply text-sm font-bold text-ink truncate;
  }

  .alumni-meta {
    @apply text-xs text-muted-2;
  }

  .alumni-position {
    @apply flex items-center gap-1.5 mt-1 text-xs text-accent/80;
  }

  .alumni-linkedin {
    @apply p-2 rounded-lg shrink-0 no-underline;
    @apply text-muted/50 bg-transparent;
    @apply transition-all duration-200;
  }

  .alumni-card:hover .alumni-linkedin {
    @apply text-muted;
  }

  .alumni-linkedin:hover {
    @apply text-[#0077B5] bg-[#0077B5]/10;
  }

  /* ============================================
     Join CTA Section
     ============================================ */
  .join-section {
    @apply relative py-24 overflow-hidden;
  }

  .join-bg {
    @apply absolute inset-0;
  }

  .join-gradient {
    @apply absolute inset-0;
    background:
      radial-gradient(ellipse 100% 80% at 50% 100%, rgba(56, 189, 248, 0.1) 0%, transparent 50%),
      linear-gradient(180deg, #0f172a 0%, #0b2545 100%);
  }

  .join-pattern {
    @apply absolute inset-0 opacity-5;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2338bdf8' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .join-content {
    @apply text-center max-w-2xl mx-auto;
  }

  .join-eyebrow {
    @apply block text-xs font-bold uppercase tracking-[0.2em] text-accent/80 mb-4;
  }

  .join-title {
    @apply text-fluid-4xl font-black text-ink mb-6;
    letter-spacing: -0.02em;
  }

  .join-description {
    @apply text-fluid-lg text-muted leading-relaxed mb-10 mx-auto;
  }

  .join-cta-group {
    @apply flex flex-col sm:flex-row items-center justify-center gap-4;
  }

  .join-btn-primary {
    @apply inline-flex items-center gap-2 px-8 py-4;
    @apply text-sm font-bold text-white no-underline;
    @apply bg-accent rounded-full;
    @apply shadow-xl shadow-accent/25;
    @apply transition-all duration-300;
  }

  .join-btn-primary:hover {
    @apply bg-accent/90 gap-3;
    box-shadow: 0 24px 48px -12px rgba(56, 189, 248, 0.5);
    transform: translateY(-3px);
  }

  .join-btn-secondary {
    @apply inline-flex items-center gap-2 px-8 py-4;
    @apply text-sm font-bold text-ink no-underline;
    @apply border-2 border-line/50 rounded-full;
    @apply transition-all duration-300;
  }

  .join-btn-secondary:hover {
    @apply border-accent/50 text-accent;
  }

  /* ============================================
     Reduced Motion
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
    .team-card:hover .card-inner,
    .team-card:hover .card-image,
    .alumni-card:hover .alumni-card-inner,
    .join-btn-primary:hover {
      transform: none;
    }
  }
</style>
